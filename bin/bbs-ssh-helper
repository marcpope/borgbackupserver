#!/usr/bin/env bash
#
# BBS SSH Helper — runs as root via sudo to manage Unix users for borg SSH access.
#
# Usage:
#   bbs-ssh-helper create-user <username> <home_dir> <public_key>
#   bbs-ssh-helper create-repo-dir <repo_dir>
#   bbs-ssh-helper borg-init <repo_path> <encryption> [passphrase]
#   bbs-ssh-helper borg-passphrase <username> <repo_path>   (old/new on stdin)
#   bbs-ssh-helper delete-user <username>
#   bbs-ssh-helper cert-status [domain]
#   bbs-ssh-helper cert-renew [domain] [--force]
#   bbs-ssh-helper cert-email <address|--remove>
#   bbs-ssh-helper install-gate
#   bbs-ssh-helper update-all-keys
#
# Install:
#   cp bin/bbs-ssh-helper /usr/local/bin/bbs-ssh-helper
#   chmod 755 /usr/local/bin/bbs-ssh-helper
#   echo "www-data ALL=(root) NOPASSWD: /usr/local/bin/bbs-ssh-helper, /var/www/bbs/bin/bbs-update" > /etc/sudoers.d/bbs-ssh-helper
#
set -euo pipefail

ACTION="${1:-}"

# Check if a path is under /var/bbs/ or a registered storage location.
# Paths are canonicalized with readlink -m (resolves symlinks and `..`
# segments without requiring the path to exist) before the allow-list
# check, so crafted inputs like `/var/bbs/../etc/shadow` cannot bypass
# the prefix match.
is_allowed_path() {
    local CHECK_PATH="$1"

    # Must be an absolute path
    [ -z "$CHECK_PATH" ] && return 1
    [[ "$CHECK_PATH" != /* ]] && return 1

    # Canonicalize — symlinks resolved, .. collapsed, no existence required
    local NORMALIZED
    NORMALIZED=$(readlink -m "$CHECK_PATH" 2>/dev/null || echo "")
    [ -z "$NORMALIZED" ] && return 1

    # Defense in depth — readlink -m should never leave `..` behind
    [[ "$NORMALIZED" == *"/../"* ]] && return 1
    [[ "$NORMALIZED" == *"/.." ]] && return 1

    # Check against allow-list
    [[ "$NORMALIZED" =~ ^/var/bbs(/|$) ]] && return 0
    if [ -f /etc/bbs/allowed-storage-paths ]; then
        while IFS= read -r allowed_path; do
            [ -z "$allowed_path" ] && continue
            local ALLOWED_NORM
            ALLOWED_NORM=$(readlink -m "$allowed_path" 2>/dev/null || echo "$allowed_path")
            [[ "$NORMALIZED" == "$ALLOWED_NORM" ]] && return 0
            [[ "$NORMALIZED" == "$ALLOWED_NORM"/* ]] && return 0
        done < /etc/bbs/allowed-storage-paths
    fi
    return 1
}

case "$ACTION" in
    create-user)
        USERNAME="${2:-}"
        HOME_DIR="${3:-}"
        PUBLIC_KEY="${4:-}"

        if [ -z "$USERNAME" ] || [ -z "$HOME_DIR" ] || [ -z "$PUBLIC_KEY" ]; then
            echo "Usage: bbs-ssh-helper create-user <username> <home_dir> <public_key>"
            exit 1
        fi

        # Validate username format (must start with bbs-)
        if [[ ! "$USERNAME" =~ ^bbs-[a-z0-9_-]+$ ]]; then
            echo "Error: username must match bbs-[a-z0-9_-]+"
            exit 1
        fi

        # Create home directory if needed
        mkdir -p "$HOME_DIR"

        # Create user with no password, no login shell, home at storage path
        if id "$USERNAME" &>/dev/null; then
            echo "User $USERNAME already exists"
        else
            useradd --shell /bin/sh --home-dir "$HOME_DIR" --no-create-home "$USERNAME"
            echo "Created user: $USERNAME"
        fi

        # Set ownership: user owns, www-data group for server-side borg operations (init, prune, compact)
        # This MUST succeed — sshd requires correct ownership of home/.ssh for key auth.
        # If this fails (e.g. NAS/NFS mount), the SSH home dir must be on a local filesystem.
        if ! chown "$USERNAME":www-data "$HOME_DIR" 2>&1; then
            echo "Error: chown failed on $HOME_DIR — SSH home directories must be on a local filesystem, not a NAS/NFS mount. Check your storage_path setting."
            exit 1
        fi
        chmod 750 "$HOME_DIR"

        # Add user to www-data group so catalog files can be chgrp'd to www-data
        # (needed on FUSE/shfs filesystems like Unraid where setgid is not honored)
        usermod -a -G www-data "$USERNAME" 2>/dev/null || true

        # Configure SSH authorized_keys with gate dispatcher
        SSH_DIR="$HOME_DIR/.ssh"
        mkdir -p "$SSH_DIR"
        chmod 700 "$SSH_DIR"

        AUTHORIZED_KEYS="$SSH_DIR/authorized_keys"
        RESTRICT_CMD="command=\"/usr/local/bin/bbs-ssh-gate $HOME_DIR\",restrict"

        echo "$RESTRICT_CMD $PUBLIC_KEY" > "$AUTHORIZED_KEYS"
        chmod 600 "$AUTHORIZED_KEYS"
        chown -R "$USERNAME":"$USERNAME" "$SSH_DIR"

        # Create catalog log directory with setgid so files inherit www-data group
        CATALOG_DIR="$HOME_DIR/.catalog-logs"
        mkdir -p "$CATALOG_DIR"
        chown "$USERNAME":www-data "$CATALOG_DIR"
        chmod 2770 "$CATALOG_DIR"

        echo "OK"
        ;;

    create-repo-dir)
        REPO_DIR="${2:-}"

        if [ -z "$REPO_DIR" ]; then
            echo "Usage: bbs-ssh-helper create-repo-dir <repo_dir>"
            exit 1
        fi

        if ! is_allowed_path "$REPO_DIR"; then
            echo "Error: repo dir must be under /var/bbs/ or a registered storage location"
            exit 1
        fi

        # Check if parent needs to be created (e.g., /var/bbs/home/3/ for user's home)
        PARENT_DIR=$(dirname "$REPO_DIR")
        if [ ! -d "$PARENT_DIR" ]; then
            # Parent doesn't exist - need to create and set ownership
            # For paths like /var/bbs/home/3/reponame, the parent is the user's home
            mkdir -p "$PARENT_DIR"
        fi

        # Create the repo directory
        mkdir -p "$REPO_DIR"

        # Find the bbs-* user who owns the parent directory.
        # On NFS with admin mapping, stat may return UNKNOWN or the NFS-mapped user,
        # so we also search by path when the owner isn't a bbs-* user.
        PARENT_OWNER=$(stat -c '%U' "$PARENT_DIR")

        if [[ ! "$PARENT_OWNER" =~ ^bbs- ]]; then
            # Parent not owned by a bbs-* user (could be root, UNKNOWN, or NFS-mapped).
            # Try to find the correct bbs-* user by matching the directory path.
            ACTUAL_USER=$(awk -F: -v home="$PARENT_DIR" '$6 == home && $1 ~ /^bbs-/ {print $1}' /etc/passwd)
            if [ -z "$ACTUAL_USER" ]; then
                BASENAME=$(basename "$PARENT_DIR")
                if [[ "$BASENAME" =~ ^[0-9]+$ ]]; then
                    ACTUAL_USER=$(awk -F: -v aid="/$BASENAME" '$6 ~ aid"$" && $1 ~ /^bbs-/ {print $1}' /etc/passwd)
                fi
            fi
            if [ -n "$ACTUAL_USER" ]; then
                PARENT_OWNER="$ACTUAL_USER"
            fi
        fi

        # Set ownership (may fail on NFS with admin mapping — non-fatal)
        if [[ "$PARENT_OWNER" =~ ^bbs- ]]; then
            chown "$PARENT_OWNER":www-data "$PARENT_DIR" 2>/dev/null || true
            chmod 750 "$PARENT_DIR" 2>/dev/null || true
            chown "$PARENT_OWNER":www-data "$REPO_DIR" 2>/dev/null || true
        fi
        chmod 770 "$REPO_DIR" 2>/dev/null || true
        echo "OK"
        ;;

    borg-extract)
        # Run borg extract as the repo-owning user
        # Usage: bbs-ssh-helper borg-extract <username> <tmpdir> <passphrase|-> <repo::archive> [paths...]
        # When <passphrase> is "-", the passphrase is read from the first
        # line of stdin (avoids argv/`ps` exposure).
        USERNAME="${2:-}"
        TMPDIR="${3:-}"
        PASSPHRASE="${4:-}"
        shift 4 2>/dev/null || true
        if [ "$PASSPHRASE" = "-" ]; then IFS= read -r PASSPHRASE || PASSPHRASE=""; fi

        if [ -z "$USERNAME" ] || [ -z "$TMPDIR" ] || [ $# -eq 0 ]; then
            echo "Usage: bbs-ssh-helper borg-extract <username> <tmpdir> <passphrase> <repo::archive> [paths...]"
            exit 1
        fi

        if [[ ! "$USERNAME" =~ ^bbs-[a-z0-9_-]+$ ]]; then
            echo "Error: username must match bbs-[a-z0-9_-]+"
            exit 1
        fi

        # Safety: staging must be under the data volume's tmp (preferred —
        # sized for backup data, #344) or legacy /tmp
        if [[ ! "$TMPDIR" =~ ^(/var/bbs/tmp|/tmp)/ ]]; then
            echo "Error: tmpdir must be under /var/bbs/tmp/ or /tmp/"
            exit 1
        fi

        # Ensure tmpdir exists and is writable by the user
        mkdir -p "$TMPDIR"
        chown "$USERNAME":www-data "$TMPDIR"
        chmod 770 "$TMPDIR"

        # Per-user borg cache dir (matches scheduler.php and bbs-update)
        BORG_DIR="/var/bbs/cache/$USERNAME"
        mkdir -p "$BORG_DIR"
        chown "$USERNAME":"$USERNAME" "$BORG_DIR"

        # Run borg extract as the repo-owning user
        cd "$TMPDIR"
        sudo -u "$USERNAME" \
            BORG_PASSPHRASE="$PASSPHRASE" \
            BORG_UNKNOWN_UNENCRYPTED_REPO_ACCESS_IS_OK=yes \
            BORG_RELOCATED_REPO_ACCESS_IS_OK=yes \
            BORG_BASE_DIR="$BORG_DIR" \
            HOME="$BORG_DIR" \
            borg extract "$@" 2>&1

        EXIT_CODE=$?

        # Make extracted files readable by www-data for tar/streaming
        # Redirect to /dev/null to avoid SIGPIPE if caller closed the pipe
        chown -R "$USERNAME":www-data "$TMPDIR" >/dev/null 2>&1
        find "$TMPDIR" -type d -exec chmod 770 {} + >/dev/null 2>&1
        find "$TMPDIR" -type f -exec chmod 660 {} + >/dev/null 2>&1

        exit $EXIT_CODE
        ;;

    verify-repo)
        # Verify a borg repo exists and return JSON (encryption mode, archive list).
        # Runs as root since repo may have arbitrary ownership before import.
        # Usage: bbs-ssh-helper verify-repo <passphrase|-> <repo_path>
        PASSPHRASE="${2:-}"
        REPO_PATH="${3:-}"
        if [ "$PASSPHRASE" = "-" ]; then IFS= read -r PASSPHRASE || PASSPHRASE=""; fi

        if [ -z "$REPO_PATH" ]; then
            echo "Usage: bbs-ssh-helper verify-repo <passphrase> <repo_path>"
            exit 1
        fi

        if ! is_allowed_path "$REPO_PATH"; then
            echo "Error: repo path must be under /var/bbs/ or a registered storage location"
            exit 1
        fi

        mkdir -p /tmp/bbs-verify

        # Do NOT use 2>&1 here — borg's first-run cache initialization and
        # security info messages on stderr corrupt the JSON output, causing
        # json_decode in PHP to fail and the import button to "not find" the
        # repo on the first click. The PHP caller captures stdout and stderr
        # on separate pipes, so leave them separated.
        BORG_PASSPHRASE="$PASSPHRASE" \
        BORG_UNKNOWN_UNENCRYPTED_REPO_ACCESS_IS_OK=yes \
        BORG_RELOCATED_REPO_ACCESS_IS_OK=yes \
        BORG_BASE_DIR="/tmp/bbs-verify" \
        HOME="/tmp/bbs-verify" \
            borg list --json "$REPO_PATH"

        exit $?
        ;;

    find-repos)
        # Walk a storage path and list borg repositories as JSON lines:
        #   {"path":"...","name":"...","size_bytes":N,"mtime":N,"key_in_repo":0|1,"device":"..."}
        # A borg repo is a directory holding a `config` file with a
        # [repository] section and a `data` subdirectory. key_in_repo=1
        # means repokey-style encryption (key stored inside the repo);
        # 0 means unencrypted OR keyfile mode (key lives elsewhere).
        # Usage: bbs-ssh-helper find-repos <base_path>
        BASE_PATH="${2:-}"

        if [ -z "$BASE_PATH" ]; then
            echo "Usage: bbs-ssh-helper find-repos <base_path>"
            exit 1
        fi
        if ! is_allowed_path "$BASE_PATH"; then
            echo "Error: base path must be under /var/bbs/ or a registered storage location"
            exit 1
        fi
        if [ ! -d "$BASE_PATH" ]; then
            echo "Error: base path does not exist: $BASE_PATH"
            exit 1
        fi

        # -maxdepth 6 bounds the walk; repos normally sit 2 levels deep
        # (<loc>/<agent_id>/<name>) but disaster-recovery copies can be
        # nested under extra folders.
        find "$BASE_PATH" -maxdepth 6 -type f -name config 2>/dev/null | while IFS= read -r CFG; do
            REPO_DIR=$(dirname "$CFG")
            [ -d "$REPO_DIR/data" ] || continue
            grep -q '^\[repository\]' "$CFG" 2>/dev/null || continue

            SIZE=$(du -sb "$REPO_DIR" 2>/dev/null | cut -f1)
            MTIME=$(stat -c %Y "$REPO_DIR" 2>/dev/null || echo 0)
            DEVICE=$(stat -c %d "$REPO_DIR" 2>/dev/null || echo 0)
            KEY_IN_REPO=0
            grep -q '^key = ' "$CFG" 2>/dev/null && KEY_IN_REPO=1
            NAME=$(basename "$REPO_DIR")

            printf '{"path":"%s","name":"%s","size_bytes":%s,"mtime":%s,"key_in_repo":%s,"device":"%s"}\n' \
                "$REPO_DIR" "$NAME" "${SIZE:-0}" "${MTIME:-0}" "$KEY_IN_REPO" "$DEVICE"
        done
        exit 0
        ;;

    check-move)
        # Report whether moving a repo from <src> to <dst> is a same-filesystem
        # rename or a cross-filesystem copy, and whether space suffices.
        # <dst> does not need to exist — the nearest existing ancestor is used
        # for the filesystem/space check.
        # Output JSON: {"src_bytes":N,"same_fs":0|1,"free_bytes":N,"fits":0|1}
        # Usage: bbs-ssh-helper check-move <src> <dst>
        SRC="${2:-}"
        DST="${3:-}"

        if [ -z "$SRC" ] || [ -z "$DST" ]; then
            echo "Usage: bbs-ssh-helper check-move <src> <dst>"
            exit 1
        fi
        if ! is_allowed_path "$SRC" || ! is_allowed_path "$DST"; then
            echo "Error: paths must be under /var/bbs/ or a registered storage location"
            exit 1
        fi
        if [ ! -d "$SRC" ]; then
            echo "Error: source does not exist: $SRC"
            exit 1
        fi

        DST_CHECK=$(readlink -m "$DST")
        while [ ! -d "$DST_CHECK" ] && [ "$DST_CHECK" != "/" ]; do
            DST_CHECK=$(dirname "$DST_CHECK")
        done

        SRC_BYTES=$(du -sb "$SRC" 2>/dev/null | cut -f1)
        SRC_DEV=$(stat -c %d "$SRC")
        DST_DEV=$(stat -c %d "$DST_CHECK")
        FREE_BYTES=$(df -P -B1 "$DST_CHECK" | awk 'NR==2 {print $4}')

        SAME_FS=0
        [ "$SRC_DEV" = "$DST_DEV" ] && SAME_FS=1

        # A rename needs no space; a copy needs the full repo size plus 2%
        # slack for filesystem overhead.
        FITS=1
        if [ "$SAME_FS" = "0" ]; then
            REQUIRED=$(( SRC_BYTES + SRC_BYTES / 50 ))
            [ "$FREE_BYTES" -lt "$REQUIRED" ] && FITS=0
        fi

        printf '{"src_bytes":%s,"same_fs":%s,"free_bytes":%s,"fits":%s}\n' \
            "${SRC_BYTES:-0}" "$SAME_FS" "${FREE_BYTES:-0}" "$FITS"
        exit 0
        ;;

    move-repo)
        # Move a borg repository into its canonical location. Same-filesystem
        # moves are an instant rename; cross-filesystem moves copy first and
        # delete the source only after the copy fully succeeds, so a failure
        # can never lose the original repo.
        # Usage: bbs-ssh-helper move-repo <src> <dst>
        SRC="${2:-}"
        DST="${3:-}"

        if [ -z "$SRC" ] || [ -z "$DST" ]; then
            echo "Usage: bbs-ssh-helper move-repo <src> <dst>"
            exit 1
        fi
        if ! is_allowed_path "$SRC" || ! is_allowed_path "$DST"; then
            echo "Error: paths must be under /var/bbs/ or a registered storage location"
            exit 1
        fi
        if [ ! -d "$SRC" ]; then
            echo "Error: source does not exist: $SRC"
            exit 1
        fi
        if [ ! -f "$SRC/config" ] || ! grep -q '^\[repository\]' "$SRC/config" 2>/dev/null; then
            echo "Error: source is not a borg repository: $SRC"
            exit 1
        fi
        SRC_NORM=$(readlink -m "$SRC")
        DST_NORM=$(readlink -m "$DST")
        if [ "$SRC_NORM" = "$DST_NORM" ]; then
            echo "Error: source and destination are the same path"
            exit 1
        fi
        if [ -e "$DST_NORM" ]; then
            echo "Error: destination already exists: $DST_NORM"
            exit 1
        fi

        mkdir -p "$(dirname "$DST_NORM")"

        SRC_DEV=$(stat -c %d "$SRC_NORM")
        DST_DEV=$(stat -c %d "$(dirname "$DST_NORM")")

        if [ "$SRC_DEV" = "$DST_DEV" ]; then
            mv "$SRC_NORM" "$DST_NORM"
            echo "moved (rename): $SRC_NORM -> $DST_NORM"
        else
            # Re-check space right before the copy
            SRC_BYTES=$(du -sb "$SRC_NORM" | cut -f1)
            FREE_BYTES=$(df -P -B1 "$(dirname "$DST_NORM")" | awk 'NR==2 {print $4}')
            REQUIRED=$(( SRC_BYTES + SRC_BYTES / 50 ))
            if [ "$FREE_BYTES" -lt "$REQUIRED" ]; then
                echo "Error: not enough space at destination (need ${REQUIRED} bytes, have ${FREE_BYTES})"
                exit 1
            fi
            if ! cp -a "$SRC_NORM" "$DST_NORM"; then
                rm -rf "$DST_NORM"
                echo "Error: copy failed — destination cleaned up, source untouched"
                exit 1
            fi
            rm -rf "$SRC_NORM"
            echo "moved (copy): $SRC_NORM -> $DST_NORM"
        fi
        exit 0
        ;;

    borg-list)
        # Run borg list as the repo-owning user
        # Usage: bbs-ssh-helper borg-list <username> <passphrase|-> <repo_path>
        USERNAME="${2:-}"
        PASSPHRASE="${3:-}"
        REPO_PATH="${4:-}"
        if [ "$PASSPHRASE" = "-" ]; then IFS= read -r PASSPHRASE || PASSPHRASE=""; fi

        if [ -z "$USERNAME" ] || [ -z "$REPO_PATH" ]; then
            echo "Usage: bbs-ssh-helper borg-list <username> <passphrase> <repo_path>"
            exit 1
        fi

        if [[ ! "$USERNAME" =~ ^bbs-[a-z0-9_-]+$ ]]; then
            echo "Error: username must match bbs-[a-z0-9_-]+"
            exit 1
        fi

        if ! is_allowed_path "$REPO_PATH"; then
            echo "Error: repo path must be under /var/bbs/ or a registered storage location"
            exit 1
        fi

        # Per-user borg cache dir
        BORG_DIR="/var/bbs/cache/$USERNAME"
        mkdir -p "$BORG_DIR"
        chown "$USERNAME":"$USERNAME" "$BORG_DIR"

        # Run borg list --json as the repo-owning user
        # Do NOT use 2>&1 here — borg warnings on stderr corrupt the JSON output
        # and cause json_decode to fail, which can wipe all archive records.
        # --lock-wait: wait up to 10 min for the repo lock rather than failing
        # immediately when a concurrent backup/compact is in progress.
        sudo -u "$USERNAME" \
            BORG_PASSPHRASE="$PASSPHRASE" \
            BORG_UNKNOWN_UNENCRYPTED_REPO_ACCESS_IS_OK=yes \
            BORG_RELOCATED_REPO_ACCESS_IS_OK=yes \
            BORG_BASE_DIR="$BORG_DIR" \
            HOME="$BORG_DIR" \
            borg list --lock-wait 600 --json "$REPO_PATH"

        exit $?
        ;;

    borg-list-archive)
        # List files in a specific archive (for catalog rebuild)
        # Usage: bbs-ssh-helper borg-list-archive <username> <passphrase|-> <repo_path>::<archive_name>
        # Output: JSON array of file paths
        USERNAME="${2:-}"
        PASSPHRASE="${3:-}"
        ARCHIVE_PATH="${4:-}"
        if [ "$PASSPHRASE" = "-" ]; then IFS= read -r PASSPHRASE || PASSPHRASE=""; fi

        if [ -z "$USERNAME" ] || [ -z "$ARCHIVE_PATH" ]; then
            echo "Usage: bbs-ssh-helper borg-list-archive <username> <passphrase> <repo::archive>"
            exit 1
        fi

        if [[ ! "$USERNAME" =~ ^bbs-[a-z0-9_-]+$ ]]; then
            echo "Error: username must match bbs-[a-z0-9_-]+"
            exit 1
        fi

        # Extract repo path from archive path (before ::)
        REPO_PATH="${ARCHIVE_PATH%%::*}"

        if ! is_allowed_path "$REPO_PATH"; then
            echo "Error: repo path must be under /var/bbs/ or a registered storage location"
            exit 1
        fi

        # Per-user borg cache dir
        BORG_DIR="/var/bbs/cache/$USERNAME"
        mkdir -p "$BORG_DIR"
        chown "$USERNAME":"$USERNAME" "$BORG_DIR"

        # Run borg list on archive with JSON output (paths only)
        # --lock-wait: wait up to 10 min for the repo lock rather than failing
        # immediately when a concurrent backup/compact is in progress.
        sudo -u "$USERNAME" \
            BORG_PASSPHRASE="$PASSPHRASE" \
            BORG_UNKNOWN_UNENCRYPTED_REPO_ACCESS_IS_OK=yes \
            BORG_RELOCATED_REPO_ACCESS_IS_OK=yes \
            BORG_BASE_DIR="$BORG_DIR" \
            HOME="$BORG_DIR" \
            borg list --lock-wait 600 --json-lines "$ARCHIVE_PATH" 2>&1

        exit $?
        ;;

    borg-cmd)
        # Run one of the allow-listed borg subcommands as the repo-owning user
        # Usage: bbs-ssh-helper borg-cmd <username> <passphrase|-> <borg-subcommand> [args...]
        # When <passphrase> is "-", the passphrase is read from the first
        # line of stdin (avoids argv/`ps` exposure).
        USERNAME="${2:-}"
        PASSPHRASE="${3:-}"
        shift 3 2>/dev/null || true
        if [ "$PASSPHRASE" = "-" ]; then IFS= read -r PASSPHRASE || PASSPHRASE=""; fi
        # Remaining args are the borg subcommand and its arguments

        if [ -z "$USERNAME" ] || [ $# -eq 0 ]; then
            echo "Usage: bbs-ssh-helper borg-cmd <username> <passphrase> <borg-subcommand> [args...]"
            exit 1
        fi

        if [[ ! "$USERNAME" =~ ^bbs-[a-z0-9_-]+$ ]]; then
            echo "Error: username must match bbs-[a-z0-9_-]+"
            exit 1
        fi

        # Allowlist borg subcommands this wrapper is permitted to run. Any
        # other subcommand — including init, extract, list (have dedicated
        # wrappers), create, mount, serve, export-tar, config — is rejected.
        BORG_SUBCMD="$1"
        case "$BORG_SUBCMD" in
            prune|compact|check|break-lock|delete|info|rename) ;;
            *)
                echo "Error: borg subcommand '$BORG_SUBCMD' is not permitted via borg-cmd"
                exit 1
                ;;
        esac

        # Reject flags that can reshape borg's execution environment:
        # --rsh lets the caller specify an arbitrary SSH/shell command,
        # --remote-path lets them point at an alternate borg binary, and
        # --debug-profile writes debug dumps to an arbitrary path.
        for arg in "$@"; do
            case "$arg" in
                --rsh|--rsh=*|--remote-path|--remote-path=*|--debug-profile|--debug-profile=*)
                    echo "Error: flag '$arg' is not permitted"
                    exit 1
                    ;;
            esac
        done

        # Validate that at least one arg is an allowed path
        FOUND_ALLOWED_PATH=false
        for arg in "$@"; do
            # Strip any ::archive suffix so the path portion can be checked
            PATH_ONLY="${arg%%::*}"
            if is_allowed_path "$PATH_ONLY"; then
                FOUND_ALLOWED_PATH=true
                break
            fi
        done
        if [ "$FOUND_ALLOWED_PATH" = false ]; then
            echo "Error: borg command must include a path under /var/bbs/ or a registered storage location"
            exit 1
        fi

        # Per-user borg cache dir
        BORG_DIR="/var/bbs/cache/$USERNAME"
        mkdir -p "$BORG_DIR"
        chown "$USERNAME":"$USERNAME" "$BORG_DIR"

        # Inject --lock-wait so server-side ops (compact/prune/check/info/
        # delete) wait up to 10 min for the repo lock rather than failing
        # immediately when an agent backup or another server-side task is
        # still holding it. break-lock is the only allow-listed subcommand
        # where --lock-wait is meaningless, so skip injection in that case.
        SUBCMD="$1"; shift
        if [ "$SUBCMD" = "break-lock" ]; then
            BORG_EXTRA_OPTS=()
        else
            BORG_EXTRA_OPTS=(--lock-wait 600)
        fi

        # Run borg command as the repo-owning user. BORG_CHECK_I_KNOW_WHAT_I_AM_DOING=YES
        # is only consulted when `borg check --repair` runs (skips its interactive
        # 'YES' prompt that would otherwise block server-side repair jobs); harmless
        # on every other subcommand.
        sudo -u "$USERNAME" \
            BORG_PASSPHRASE="$PASSPHRASE" \
            BORG_CHECK_I_KNOW_WHAT_I_AM_DOING=YES \
            BORG_UNKNOWN_UNENCRYPTED_REPO_ACCESS_IS_OK=yes \
            BORG_RELOCATED_REPO_ACCESS_IS_OK=yes \
            BORG_BASE_DIR="$BORG_DIR" \
            HOME="$BORG_DIR" \
            borg "$SUBCMD" "${BORG_EXTRA_OPTS[@]}" "$@" 2>&1

        exit $?
        ;;

    borg-passphrase)
        # Change a repository's passphrase (#412).
        # Usage: bbs-ssh-helper borg-passphrase <username> <repo_path>
        #        old and new passphrases on stdin, one per line.
        #
        # Not part of borg-cmd: that wrapper takes a single passphrase and an
        # allow-list this subcommand is deliberately absent from, and passing a
        # second secret through it would widen an interface used by everything
        # else.
        USERNAME="${2:-}"
        REPO_PATH="${3:-}"

        if [ -z "$USERNAME" ] || [ -z "$REPO_PATH" ]; then
            echo "Usage: bbs-ssh-helper borg-passphrase <username> <repo_path>  (passphrases on stdin)"
            exit 1
        fi
        if [[ ! "$USERNAME" =~ ^bbs-[a-z0-9_-]+$ ]]; then
            echo "Error: username must match bbs-[a-z0-9_-]+"
            exit 1
        fi
        if ! is_allowed_path "$REPO_PATH"; then
            echo "Error: repo path must be under /var/bbs/ or a registered storage location"
            exit 1
        fi

        # Read both secrets from stdin so neither appears in argv or `ps`.
        IFS= read -r OLD_PP || OLD_PP=""
        IFS= read -r NEW_PP || NEW_PP=""
        if [ -z "$NEW_PP" ]; then
            echo "Error: new passphrase is empty"
            exit 1
        fi

        BORG_DIR="/var/bbs/cache/$USERNAME"
        mkdir -p "$BORG_DIR"
        chown "$USERNAME":"$USERNAME" "$BORG_DIR"

        # --lock-wait is short on purpose. The caller has already checked that
        # no job is using this repository; if something took the lock in the
        # meantime, failing quickly is better than holding the request open for
        # ten minutes while a backup runs.
        sudo -u "$USERNAME" \
            BORG_PASSPHRASE="$OLD_PP" \
            BORG_NEW_PASSPHRASE="$NEW_PP" \
            BORG_UNKNOWN_UNENCRYPTED_REPO_ACCESS_IS_OK=yes \
            BORG_RELOCATED_REPO_ACCESS_IS_OK=yes \
            BORG_BASE_DIR="$BORG_DIR" \
            HOME="$BORG_DIR" \
            borg key change-passphrase -v --lock-wait 30 "$REPO_PATH" 2>&1

        exit $?
        ;;

    borg-init)
        # Run borg init as root so it works on NFS and other filesystems where
        # www-data may not have write access despite correct POSIX permissions.
        # Usage: bbs-ssh-helper borg-init <repo_path> <encryption> [passphrase|-]
        REPO_PATH="${2:-}"
        ENCRYPTION="${3:-}"
        PASSPHRASE="${4:-}"
        if [ "$PASSPHRASE" = "-" ]; then IFS= read -r PASSPHRASE || PASSPHRASE=""; fi

        if [ -z "$REPO_PATH" ] || [ -z "$ENCRYPTION" ]; then
            echo "Usage: bbs-ssh-helper borg-init <repo_path> <encryption> [passphrase]"
            exit 1
        fi

        if ! is_allowed_path "$REPO_PATH"; then
            echo "Error: repo path must be under /var/bbs/ or a registered storage location"
            exit 1
        fi

        # Validate encryption mode
        case "$ENCRYPTION" in
            none|repokey|repokey-blake2|keyfile|keyfile-blake2|authenticated|authenticated-blake2)
                ;;
            *)
                echo "Error: invalid encryption mode: $ENCRYPTION"
                exit 1
                ;;
        esac

        mkdir -p /tmp/bbs-borg-init

        BORG_PASSPHRASE="$PASSPHRASE" \
        BORG_UNKNOWN_UNENCRYPTED_REPO_ACCESS_IS_OK=yes \
        BORG_RELOCATED_REPO_ACCESS_IS_OK=yes \
        BORG_BASE_DIR="/tmp/bbs-borg-init" \
        HOME="/tmp/bbs-borg-init" \
            borg init "--encryption=$ENCRYPTION" "$REPO_PATH" 2>&1

        exit $?
        ;;

    fix-repo-perms)
        REPO_DIR="${2:-}"
        USERNAME="${3:-}"

        if [ -z "$REPO_DIR" ] || [ -z "$USERNAME" ]; then
            echo "Usage: bbs-ssh-helper fix-repo-perms <repo_dir> <username>"
            exit 1
        fi

        if ! is_allowed_path "$REPO_DIR"; then
            echo "Error: repo dir must be under /var/bbs/ or a registered storage location"
            exit 1
        fi
        if [[ ! "$USERNAME" =~ ^bbs-[a-z0-9_-]+$ ]]; then
            echo "Error: username must match bbs-[a-z0-9_-]+"
            exit 1
        fi

        if [ -d "$REPO_DIR" ]; then
            # chown may fail on NFS with admin mapping — non-fatal since
            # all users map to the same NFS user anyway
            chown -R "$USERNAME":www-data "$REPO_DIR" 2>/dev/null || true
            chmod 770 "$REPO_DIR" 2>/dev/null || true
        fi
        echo "OK"
        ;;

    delete-user)
        USERNAME="${2:-}"

        if [ -z "$USERNAME" ]; then
            echo "Usage: bbs-ssh-helper delete-user <username>"
            exit 1
        fi

        # Safety: only delete bbs- prefixed users
        if [[ ! "$USERNAME" =~ ^bbs-[a-z0-9_-]+$ ]]; then
            echo "Error: will only delete users matching bbs-[a-z0-9_-]+"
            exit 1
        fi

        if id "$USERNAME" &>/dev/null; then
            userdel "$USERNAME" 2>/dev/null || true
            echo "Deleted user: $USERNAME"
        else
            echo "User $USERNAME does not exist"
        fi

        echo "OK"
        ;;

    update-borg)
        # Download and install a borg binary to /usr/local/bin/borg
        # Usage: bbs-ssh-helper update-borg <download_url> <expected_version>
        DOWNLOAD_URL="${2:-}"
        EXPECTED_VERSION="${3:-}"

        if [ -z "$DOWNLOAD_URL" ] || [ -z "$EXPECTED_VERSION" ]; then
            echo "Usage: bbs-ssh-helper update-borg <download_url> <expected_version>"
            exit 1
        fi

        # Safety: only allow downloads from GitHub
        if [[ ! "$DOWNLOAD_URL" =~ ^https://github\.com/borgbackup/borg/releases/ ]]; then
            echo "Error: download URL must be from github.com/borgbackup/borg/releases"
            exit 1
        fi

        BORG_PATH="/usr/local/bin/borg"
        BORG_TMP="/usr/local/bin/borg.tmp"

        # Download binary
        if ! curl -sL -o "$BORG_TMP" "$DOWNLOAD_URL"; then
            rm -f "$BORG_TMP"
            echo "Error: failed to download from $DOWNLOAD_URL"
            exit 1
        fi

        chmod 755 "$BORG_TMP"

        # Verify it runs and outputs expected version
        ACTUAL=$("$BORG_TMP" --version 2>/dev/null || true)
        # Output may be "borg 1.4.3" or "borg.tmp 1.4.3" — extract version number
        ACTUAL_VER=$(echo "$ACTUAL" | grep -oP '[0-9]+\.[0-9]+\.[0-9]+' | head -1)

        if [ "$ACTUAL_VER" != "$EXPECTED_VERSION" ]; then
            rm -f "$BORG_TMP"
            echo "Error: version mismatch — expected $EXPECTED_VERSION, got $ACTUAL_VER"
            exit 1
        fi

        # Backup old binary if it exists at this path
        if [ -f "$BORG_PATH" ]; then
            cp "$BORG_PATH" "${BORG_PATH}.bak"
        fi

        # Atomic replace
        mv "$BORG_TMP" "$BORG_PATH"
        echo "Installed borg $EXPECTED_VERSION to $BORG_PATH"
        echo "OK"
        ;;

    rclone-sync)
        # Run rclone sync as the repo-owning user
        #
        # The timeouts below matter more than they look. Without them an
        # endpoint that drops packets rather than refusing them — a tunnel that
        # went down, a firewall blackhole — leaves rclone waiting with no
        # output but its 5-second stats line, showing 0 B/s forever, and the
        # job sits in 'running' until someone notices (#438). They are connect
        # and idle timeouts, so a slow transfer that is still moving is not
        # affected.
        # Usage: bbs-ssh-helper rclone-sync <username> <local_path> <remote> <endpoint> <region> <access_key> <secret_key> [--bwlimit LIMIT]
        USERNAME="${2:-}"
        LOCAL_PATH="${3:-}"
        REMOTE="${4:-}"
        S3_ENDPOINT="${5:-}"
        S3_REGION="${6:-}"
        S3_ACCESS_KEY="${7:-}"
        S3_SECRET_KEY="${8:-}"
        shift 8 2>/dev/null || true
        # Remaining args are optional rclone flags (e.g. --bwlimit 50M)
        EXTRA_ARGS=("$@")

        if [ -z "$USERNAME" ] || [ -z "$LOCAL_PATH" ] || [ -z "$REMOTE" ]; then
            echo "Usage: bbs-ssh-helper rclone-sync <username> <local_path> <remote> <endpoint> <region> <access_key> <secret_key> [rclone flags...]"
            exit 1
        fi

        if [[ ! "$USERNAME" =~ ^bbs-[a-z0-9_-]+$ ]]; then
            echo "Error: username must match bbs-[a-z0-9_-]+"
            exit 1
        fi

        # Safety: local path must be under /var/bbs/ or a registered storage
        # location. Use the shared allow-list so installations with
        # repos in non-standard paths (e.g. /opt/bbs, /mnt/...) can sync
        # to S3 like everything else does (#270).
        if ! is_allowed_path "$LOCAL_PATH"; then
            echo "Error: local path must be under /var/bbs/ or a registered storage location"
            exit 1
        fi

        # Ensure cache directory exists for the user
        CACHE_DIR="/var/bbs/cache/$USERNAME/rclone"
        mkdir -p "$CACHE_DIR"
        chown -R "$USERNAME":"$USERNAME" "/var/bbs/cache/$USERNAME"

        # Run rclone as the repo-owning user with S3 config via env vars
        # Set HOME and XDG dirs to writable locations to prevent permission errors
        sudo -u "$USERNAME" env \
            "HOME=/var/bbs/cache/$USERNAME" \
            "XDG_CACHE_HOME=$CACHE_DIR" \
            "XDG_CONFIG_HOME=/var/bbs/cache/$USERNAME" \
            "RCLONE_CONFIG=/dev/null" \
            "RCLONE_CONFIG_S3_TYPE=s3" \
            "RCLONE_CONFIG_S3_PROVIDER=Other" \
            "RCLONE_CONFIG_S3_ACCESS_KEY_ID=${S3_ACCESS_KEY}" \
            "RCLONE_CONFIG_S3_SECRET_ACCESS_KEY=${S3_SECRET_KEY}" \
            "RCLONE_CONFIG_S3_ENDPOINT=${S3_ENDPOINT}" \
            "RCLONE_CONFIG_S3_REGION=${S3_REGION}" \
            rclone sync "$LOCAL_PATH" "$REMOTE" \
            --transfers 4 --checkers 8 \
            -v --stats-one-line --stats 5s \
            --s3-no-check-bucket \
            --contimeout 30s --timeout 5m --retries 2 --low-level-retries 5 \
            "${EXTRA_ARGS[@]}" 2>&1

        exit $?
        ;;

    rclone-restore)
        # Run rclone sync FROM S3 TO local (restore)
        # Usage: bbs-ssh-helper rclone-restore <username> <remote> <local_path> <endpoint> <region> <access_key> <secret_key> [--bwlimit LIMIT]
        USERNAME="${2:-}"
        REMOTE="${3:-}"
        LOCAL_PATH="${4:-}"
        S3_ENDPOINT="${5:-}"
        S3_REGION="${6:-}"
        S3_ACCESS_KEY="${7:-}"
        S3_SECRET_KEY="${8:-}"
        shift 8 2>/dev/null || true
        # Remaining args are optional rclone flags (e.g. --bwlimit 50M)
        EXTRA_ARGS=("$@")

        if [ -z "$USERNAME" ] || [ -z "$LOCAL_PATH" ] || [ -z "$REMOTE" ]; then
            echo "Usage: bbs-ssh-helper rclone-restore <username> <remote> <local_path> <endpoint> <region> <access_key> <secret_key> [rclone flags...]"
            exit 1
        fi

        if [[ ! "$USERNAME" =~ ^bbs-[a-z0-9_-]+$ ]]; then
            echo "Error: username must match bbs-[a-z0-9_-]+"
            exit 1
        fi

        # Same allow-list as rclone-sync — repos in non-standard locations
        # need to restore from S3 too (#270).
        if ! is_allowed_path "$LOCAL_PATH"; then
            echo "Error: local path must be under /var/bbs/ or a registered storage location"
            exit 1
        fi

        # Ensure parent directory exists and has correct ownership
        # This handles cases where the user's home dir (/var/bbs/home/N/) might not exist
        PARENT_DIR=$(dirname "$LOCAL_PATH")
        mkdir -p "$PARENT_DIR"
        # Fix ownership if parent is a user home dir owned by root
        if [[ "$PARENT_DIR" =~ ^/var/bbs/home/[0-9]+$ ]]; then
            PARENT_OWNER=$(stat -c '%U' "$PARENT_DIR")
            if [ "$PARENT_OWNER" = "root" ]; then
                chown "$USERNAME":www-data "$PARENT_DIR"
                chmod 750 "$PARENT_DIR"
            fi
        fi

        # Create local directory if needed
        mkdir -p "$LOCAL_PATH"
        chown "$USERNAME":www-data "$LOCAL_PATH"
        chmod 770 "$LOCAL_PATH"

        # Ensure cache directory exists for the user
        CACHE_DIR="/var/bbs/cache/$USERNAME/rclone"
        mkdir -p "$CACHE_DIR"
        chown -R "$USERNAME":"$USERNAME" "/var/bbs/cache/$USERNAME"

        # Run rclone as the repo-owning user with S3 config via env vars
        # Set HOME and XDG dirs to writable locations to prevent permission errors
        # Note: sync FROM remote TO local (reverse of rclone-sync)
        sudo -u "$USERNAME" env \
            "HOME=/var/bbs/cache/$USERNAME" \
            "XDG_CACHE_HOME=$CACHE_DIR" \
            "XDG_CONFIG_HOME=/var/bbs/cache/$USERNAME" \
            "RCLONE_CONFIG=/dev/null" \
            "RCLONE_CONFIG_S3_TYPE=s3" \
            "RCLONE_CONFIG_S3_PROVIDER=Other" \
            "RCLONE_CONFIG_S3_ACCESS_KEY_ID=${S3_ACCESS_KEY}" \
            "RCLONE_CONFIG_S3_SECRET_ACCESS_KEY=${S3_SECRET_KEY}" \
            "RCLONE_CONFIG_S3_ENDPOINT=${S3_ENDPOINT}" \
            "RCLONE_CONFIG_S3_REGION=${S3_REGION}" \
            rclone sync "$REMOTE" "$LOCAL_PATH" \
            --transfers 4 --checkers 8 \
            -v --stats-one-line --stats 5s \
            --s3-no-check-bucket \
            --contimeout 30s --timeout 5m --retries 2 --low-level-retries 5 \
            "${EXTRA_ARGS[@]}" 2>&1

        EXIT_CODE=$?

        # Fix permissions after restore
        chown -R "$USERNAME":www-data "$LOCAL_PATH"
        chmod 770 "$LOCAL_PATH"

        exit $EXIT_CODE
        ;;

    get-size)
        # Get size of a directory in bytes
        # Usage: bbs-ssh-helper get-size <directory>
        DIR="${2:-}"

        if [ -z "$DIR" ]; then
            echo "Usage: bbs-ssh-helper get-size <directory>"
            exit 1
        fi

        if ! is_allowed_path "$DIR"; then
            echo "Error: path must be under /var/bbs/ or a registered storage location"
            exit 1
        fi

        if [ -d "$DIR" ]; then
            du -sb "$DIR" 2>/dev/null | cut -f1
        else
            echo "0"
        fi
        ;;

    delete-storage)
        STORAGE_DIR="${2:-}"

        if [ -z "$STORAGE_DIR" ]; then
            echo "Usage: bbs-ssh-helper delete-storage <directory>"
            exit 1
        fi

        # Safety: refuse to delete system directories
        case "$STORAGE_DIR" in
            /|/bin|/boot|/dev|/etc|/home|/lib*|/opt|/proc|/root|/run|/sbin|/srv|/sys|/tmp|/usr|/var|/var/www|/var/www/bbs)
                echo "Error: refusing to delete system directory: $STORAGE_DIR"
                exit 1
                ;;
        esac

        if [ -d "$STORAGE_DIR" ]; then
            rm -rf "$STORAGE_DIR"
            echo "Removed storage directory: $STORAGE_DIR"
        else
            echo "Directory does not exist: $STORAGE_DIR"
        fi

        echo "OK"
        ;;

    rename-repo-dir)
        OLD_DIR="${2:-}"
        NEW_DIR="${3:-}"

        if [ -z "$OLD_DIR" ] || [ -z "$NEW_DIR" ]; then
            echo "Usage: bbs-ssh-helper rename-repo-dir <old_dir> <new_dir>"
            exit 1
        fi

        # Reject path traversal attempts
        case "$OLD_DIR" in
            *..*)
                echo "Error: path traversal not allowed in source path"
                exit 1
                ;;
        esac
        case "$NEW_DIR" in
            *..*)
                echo "Error: path traversal not allowed in target path"
                exit 1
                ;;
        esac

        # Reject dangerous characters in the new directory basename
        NEW_BASENAME=$(basename "$NEW_DIR")
        if echo "$NEW_BASENAME" | grep -qP '[^a-zA-Z0-9._-]'; then
            echo "Error: new directory name contains invalid characters (only a-z, 0-9, dots, hyphens, underscores allowed): $NEW_BASENAME"
            exit 1
        fi
        if [ -z "$NEW_BASENAME" ] || [ "$NEW_BASENAME" = "." ] || [ "$NEW_BASENAME" = ".." ]; then
            echo "Error: invalid new directory name: $NEW_BASENAME"
            exit 1
        fi

        # Safety: refuse system directories
        case "$OLD_DIR" in
            /|/bin|/boot|/dev|/etc|/home|/lib*|/opt|/proc|/root|/run|/sbin|/srv|/sys|/tmp|/usr|/var|/var/www|/var/www/bbs)
                echo "Error: refusing to rename system directory: $OLD_DIR"
                exit 1
                ;;
        esac

        if ! is_allowed_path "$OLD_DIR"; then
            echo "Error: source path must be under /var/bbs/ or a registered storage location"
            exit 1
        fi

        if ! is_allowed_path "$NEW_DIR"; then
            echo "Error: target path must be under /var/bbs/ or a registered storage location"
            exit 1
        fi

        # Both paths must share the same parent directory (no cross-directory moves)
        OLD_PARENT=$(dirname "$OLD_DIR")
        NEW_PARENT=$(dirname "$NEW_DIR")
        if [ "$OLD_PARENT" != "$NEW_PARENT" ]; then
            echo "Error: rename must stay within the same parent directory"
            exit 1
        fi

        if [ ! -d "$OLD_DIR" ]; then
            echo "Error: source directory does not exist: $OLD_DIR"
            exit 1
        fi

        if [ -d "$NEW_DIR" ]; then
            echo "Error: target directory already exists: $NEW_DIR"
            exit 1
        fi

        mv "$OLD_DIR" "$NEW_DIR"
        echo "OK"
        ;;

    clear-borg-cache)
        # Clear borg cache for a specific user
        # Usage: bbs-ssh-helper clear-borg-cache <username>
        # This is needed after S3 restore to prevent "repository relocated" errors
        # when multiple repos share the same internal borg UUID (common with S3 copies)
        USERNAME="${2:-}"

        if [ -z "$USERNAME" ]; then
            echo "Usage: bbs-ssh-helper clear-borg-cache <username>"
            exit 1
        fi

        if [[ ! "$USERNAME" =~ ^bbs-[a-z0-9_-]+$ ]]; then
            echo "Error: username must match bbs-[a-z0-9_-]+"
            exit 1
        fi

        BORG_CACHE="/var/bbs/cache/$USERNAME/.cache/borg"
        if [ -d "$BORG_CACHE" ]; then
            rm -rf "$BORG_CACHE"
            echo "Cleared borg cache at $BORG_CACHE"
        else
            echo "No borg cache found at $BORG_CACHE"
        fi

        echo "OK"
        ;;

    server-backup)
        # Run the BBS server backup script
        # Usage: bbs-ssh-helper server-backup [--with-catalogs] [--keep N]
        # Creates a backup of the BBS database and config to /var/bbs/backups/
        BACKUP_SCRIPT="/var/www/bbs/bin/bbs-backup"

        if [ ! -f "$BACKUP_SCRIPT" ]; then
            echo "Error: backup script not found at $BACKUP_SCRIPT"
            exit 1
        fi

        # Run the backup script as root, forwarding any extra args
        "$BACKUP_SCRIPT" "${@:2}" 2>&1
        exit $?
        ;;

    rclone-server-sync)
        # Sync server backups to S3
        # Usage: bbs-ssh-helper rclone-server-sync <local_dir> <remote> <endpoint> <region> <access_key> <secret_key>
        # Example: bbs-ssh-helper rclone-server-sync /var/bbs/backups S3:bucket/_server-backups/ s3.wasabisys.com us-east-1 ACCESS SECRET
        LOCAL_DIR="${2:-}"
        REMOTE="${3:-}"
        S3_ENDPOINT="${4:-}"
        S3_REGION="${5:-}"
        S3_ACCESS_KEY="${6:-}"
        S3_SECRET_KEY="${7:-}"

        if [ -z "$LOCAL_DIR" ] || [ -z "$REMOTE" ] || [ -z "$S3_ENDPOINT" ] || [ -z "$S3_ACCESS_KEY" ]; then
            echo "Usage: bbs-ssh-helper rclone-server-sync <local_dir> <remote> <endpoint> <region> <access_key> <secret_key>"
            exit 1
        fi

        # Safety: only allow /var/bbs/backups
        if [[ "$LOCAL_DIR" != "/var/bbs/backups" ]]; then
            echo "Error: local_dir must be /var/bbs/backups"
            exit 1
        fi

        # Ensure cache directory exists
        CACHE_DIR="/var/bbs/cache/server-backup"
        mkdir -p "$CACHE_DIR"

        # Run rclone sync with S3 config via env vars
        env \
            "HOME=$CACHE_DIR" \
            "XDG_CACHE_HOME=$CACHE_DIR" \
            "XDG_CONFIG_HOME=$CACHE_DIR" \
            "RCLONE_CONFIG=/dev/null" \
            "RCLONE_CONFIG_S3_TYPE=s3" \
            "RCLONE_CONFIG_S3_PROVIDER=Other" \
            "RCLONE_CONFIG_S3_ACCESS_KEY_ID=${S3_ACCESS_KEY}" \
            "RCLONE_CONFIG_S3_SECRET_ACCESS_KEY=${S3_SECRET_KEY}" \
            "RCLONE_CONFIG_S3_ENDPOINT=${S3_ENDPOINT}" \
            "RCLONE_CONFIG_S3_REGION=${S3_REGION}" \
            rclone sync "$LOCAL_DIR" "$REMOTE" \
            --include 'bbs-backup-*.tar.gz' \
            --transfers 2 -v \
            --s3-no-check-bucket \
            --contimeout 30s --timeout 5m --retries 2 --low-level-retries 5 2>&1

        EXIT_CODE=$?
        if [ $EXIT_CODE -eq 0 ]; then
            echo "OK"
        fi
        exit $EXIT_CODE
        ;;

    rclone-server-list)
        # List server backups in the S3 _server-backups folder as rclone
        # lsjson output (the web UI's Restore from S3 Backup card, #342).
        # Usage: bbs-ssh-helper rclone-server-list <endpoint> <region> <bucket> <access_key> <secret_key> [path_prefix]
        S3_ENDPOINT="${2:-}"
        S3_REGION="${3:-}"
        S3_BUCKET="${4:-}"
        S3_ACCESS_KEY="${5:-}"
        S3_SECRET_KEY="${6:-}"
        S3_PREFIX="${7:-}"

        if [ -z "$S3_ENDPOINT" ] || [ -z "$S3_BUCKET" ] || [ -z "$S3_ACCESS_KEY" ]; then
            echo "Usage: bbs-ssh-helper rclone-server-list <endpoint> <region> <bucket> <access_key> <secret_key> [path_prefix]"
            exit 1
        fi

        REMOTE="S3:${S3_BUCKET}/${S3_PREFIX:+${S3_PREFIX}/}_server-backups/"
        CACHE_DIR="/var/bbs/cache/server-backup"
        mkdir -p "$CACHE_DIR"

        env \
            "HOME=$CACHE_DIR" \
            "XDG_CACHE_HOME=$CACHE_DIR" \
            "XDG_CONFIG_HOME=$CACHE_DIR" \
            "RCLONE_CONFIG=/dev/null" \
            "RCLONE_CONFIG_S3_TYPE=s3" \
            "RCLONE_CONFIG_S3_PROVIDER=Other" \
            "RCLONE_CONFIG_S3_ACCESS_KEY_ID=${S3_ACCESS_KEY}" \
            "RCLONE_CONFIG_S3_SECRET_ACCESS_KEY=${S3_SECRET_KEY}" \
            "RCLONE_CONFIG_S3_ENDPOINT=${S3_ENDPOINT}" \
            "RCLONE_CONFIG_S3_REGION=${S3_REGION}" \
            rclone lsjson "$REMOTE" \
            --include 'bbs-backup-*.tar.gz' \
            --s3-no-check-bucket \
            --contimeout 30s --timeout 5m --retries 2 --low-level-retries 5
        exit $?
        ;;

    rclone-server-download)
        # Download one server backup into a restore staging directory.
        # Usage: bbs-ssh-helper rclone-server-download <filename> <dest_dir> <endpoint> <region> <bucket> <access_key> <secret_key> [path_prefix]
        FILENAME="${2:-}"
        DEST_DIR="${3:-}"
        S3_ENDPOINT="${4:-}"
        S3_REGION="${5:-}"
        S3_BUCKET="${6:-}"
        S3_ACCESS_KEY="${7:-}"
        S3_SECRET_KEY="${8:-}"
        S3_PREFIX="${9:-}"

        if [ -z "$FILENAME" ] || [ -z "$DEST_DIR" ] || [ -z "$S3_ENDPOINT" ] || [ -z "$S3_BUCKET" ] || [ -z "$S3_ACCESS_KEY" ]; then
            echo "Usage: bbs-ssh-helper rclone-server-download <filename> <dest_dir> <endpoint> <region> <bucket> <access_key> <secret_key> [path_prefix]"
            exit 1
        fi
        if [[ ! "$FILENAME" =~ ^bbs-backup-[A-Za-z0-9._-]+\.tar\.gz$ ]]; then
            echo "Error: filename must match bbs-backup-*.tar.gz"
            exit 1
        fi
        if [[ ! "$DEST_DIR" =~ ^(/var/bbs/tmp|/tmp)/bbs-restore-[0-9a-f]+$ ]]; then
            echo "Error: dest_dir must be a bbs-restore-* staging directory under /var/bbs/tmp or /tmp"
            exit 1
        fi

        REMOTE="S3:${S3_BUCKET}/${S3_PREFIX:+${S3_PREFIX}/}_server-backups/${FILENAME}"
        CACHE_DIR="/var/bbs/cache/server-backup"
        mkdir -p "$CACHE_DIR" "$DEST_DIR"

        env \
            "HOME=$CACHE_DIR" \
            "XDG_CACHE_HOME=$CACHE_DIR" \
            "XDG_CONFIG_HOME=$CACHE_DIR" \
            "RCLONE_CONFIG=/dev/null" \
            "RCLONE_CONFIG_S3_TYPE=s3" \
            "RCLONE_CONFIG_S3_PROVIDER=Other" \
            "RCLONE_CONFIG_S3_ACCESS_KEY_ID=${S3_ACCESS_KEY}" \
            "RCLONE_CONFIG_S3_SECRET_ACCESS_KEY=${S3_SECRET_KEY}" \
            "RCLONE_CONFIG_S3_ENDPOINT=${S3_ENDPOINT}" \
            "RCLONE_CONFIG_S3_REGION=${S3_REGION}" \
            rclone copy "$REMOTE" "$DEST_DIR/" \
            --s3-no-check-bucket \
            --contimeout 30s --timeout 5m --retries 2 --low-level-retries 5 2>&1

        EXIT_CODE=$?
        # The web server user needs to stat the file to confirm the download
        chmod 755 "$DEST_DIR" 2>/dev/null || true
        chmod 644 "$DEST_DIR/$FILENAME" 2>/dev/null || true
        [ $EXIT_CODE -eq 0 ] && echo "OK"
        exit $EXIT_CODE
        ;;

    server-restore)
        # Restore a downloaded server backup via bbs-restore --yes. Only
        # accepts files inside a /tmp/bbs-restore-* staging directory that
        # the download subcommand above created.
        # Usage: bbs-ssh-helper server-restore <backup_file>
        BACKUP_FILE="${2:-}"

        if [ -z "$BACKUP_FILE" ]; then
            echo "Usage: bbs-ssh-helper server-restore <backup_file>"
            exit 1
        fi
        if [[ ! "$BACKUP_FILE" =~ ^(/var/bbs/tmp|/tmp)/bbs-restore-[0-9a-f]+/bbs-backup-[A-Za-z0-9._-]+\.tar\.gz$ ]]; then
            echo "Error: backup file must be inside a bbs-restore-* staging directory under /var/bbs/tmp or /tmp"
            exit 1
        fi
        if [ ! -f "$BACKUP_FILE" ]; then
            echo "Error: backup file not found: $BACKUP_FILE"
            exit 1
        fi

        RESTORE_SCRIPT="/var/www/bbs/bin/bbs-restore"
        if [ ! -f "$RESTORE_SCRIPT" ]; then
            echo "Error: bbs-restore not found at $RESTORE_SCRIPT"
            exit 1
        fi

        bash "$RESTORE_SCRIPT" --yes "$BACKUP_FILE"
        exit $?
        ;;

    install-gate)
        # Install the bbs-ssh-gate script to /usr/local/bin
        # Usage: bbs-ssh-helper install-gate
        BBS_DIR="/var/www/bbs"
        GATE_SRC="$BBS_DIR/bin/bbs-ssh-gate"
        GATE_DST="/usr/local/bin/bbs-ssh-gate"

        if [ ! -f "$GATE_SRC" ]; then
            echo "Error: gate script not found at $GATE_SRC"
            exit 1
        fi

        cp "$GATE_SRC" "$GATE_DST"
        chmod 755 "$GATE_DST"
        chown root:root "$GATE_DST"
        echo "Installed bbs-ssh-gate to $GATE_DST"

        # Ensure sshd accepts legacy algorithms for older clients. OpenSSH 10
        # (Debian 13) dropped both ssh-rsa (SHA-1) host keys and the SHA-1
        # Diffie-Hellman kex algorithms, so old clients — Windows Server 2016,
        # Dropbear NAS boxes, CentOS 6/7 — are closed at key exchange (#352).
        # Rewritten whenever the desired content changes so existing installs
        # pick up new entries (not just when the file is missing).
        SSHD_LEGACY="/etc/ssh/sshd_config.d/bbs-legacy-compat.conf"
        SSHD_CONF_DIR="/etc/ssh/sshd_config.d"
        read -r -d '' SSHD_LEGACY_CONTENT <<'SSHEOF' || true
# Added by BBS to support agents on older OS with legacy SSH clients
HostKeyAlgorithms +ssh-rsa
PubkeyAcceptedAlgorithms +ssh-rsa
KexAlgorithms +diffie-hellman-group14-sha1,diffie-hellman-group-exchange-sha1,diffie-hellman-group1-sha1
SSHEOF
        if [ -d "$SSHD_CONF_DIR" ] && { [ ! -f "$SSHD_LEGACY" ] || [ "$(cat "$SSHD_LEGACY" 2>/dev/null)" != "$SSHD_LEGACY_CONTENT" ]; }; then
            OLD_LEGACY="$(cat "$SSHD_LEGACY" 2>/dev/null || true)"
            printf '%s\n' "$SSHD_LEGACY_CONTENT" > "$SSHD_LEGACY"
            chmod 644 "$SSHD_LEGACY"
            # Validate config before restarting; restore prior content on error
            if sshd -t 2>/dev/null; then
                systemctl restart ssh 2>/dev/null || systemctl restart sshd 2>/dev/null || true
                echo "Enabled legacy SSH compatibility"
            else
                if [ -n "$OLD_LEGACY" ]; then printf '%s\n' "$OLD_LEGACY" > "$SSHD_LEGACY"; else rm -f "$SSHD_LEGACY"; fi
                echo "Warning: sshd config invalid, reverted legacy compat"
            fi
        fi
        echo "OK"
        ;;

    update-all-keys)
        # Regenerate authorized_keys for all bbs-* users to use the gate dispatcher.
        # Reads the existing public key from each user's authorized_keys file.
        # Usage: bbs-ssh-helper update-all-keys
        UPDATED=0
        SKIPPED=0

        for USERNAME in $(awk -F: '$1 ~ /^bbs-/ {print $1}' /etc/passwd); do
            HOME_DIR=$(getent passwd "$USERNAME" | cut -d: -f6)
            AK_FILE="$HOME_DIR/.ssh/authorized_keys"

            if [ ! -f "$AK_FILE" ]; then
                echo "  $USERNAME: no authorized_keys -- skipping"
                SKIPPED=$((SKIPPED + 1))
                continue
            fi

            # Extract the public key (everything after the last ",restrict " prefix)
            PUBLIC_KEY=$(sed 's/^.*,restrict //' "$AK_FILE" | head -1)

            if [ -z "$PUBLIC_KEY" ]; then
                echo "  $USERNAME: could not extract public key -- skipping"
                SKIPPED=$((SKIPPED + 1))
                continue
            fi

            # Write new authorized_keys with gate dispatcher
            RESTRICT_CMD="command=\"/usr/local/bin/bbs-ssh-gate $HOME_DIR\",restrict"
            echo "$RESTRICT_CMD $PUBLIC_KEY" > "$AK_FILE"
            chmod 600 "$AK_FILE"
            chown "$USERNAME":"$USERNAME" "$AK_FILE"

            # Create catalog log directory with setgid
            CATALOG_DIR="$HOME_DIR/.catalog-logs"
            mkdir -p "$CATALOG_DIR"
            chown "$USERNAME":www-data "$CATALOG_DIR"
            chmod 2770 "$CATALOG_DIR"

            echo "  $USERNAME: updated"
            UPDATED=$((UPDATED + 1))
        done

        echo "Updated: $UPDATED, Skipped: $SKIPPED"
        echo "OK"
        ;;

    update-storage-paths)
        # Write extra --restrict-to-path entries for a user's non-default storage locations.
        # Usage: bbs-ssh-helper update-storage-paths <home_dir> [path1] [path2] ...
        # If no paths given, removes the .storage-paths file.
        HOME_DIR="${2:-}"

        if [ -z "$HOME_DIR" ]; then
            echo "Usage: bbs-ssh-helper update-storage-paths <home_dir> [path1] [path2] ..."
            exit 1
        fi

        PATHS_FILE="$HOME_DIR/.storage-paths"

        # Ensure home directory exists (may not if user creation used a different path)
        if [ ! -d "$HOME_DIR" ]; then
            mkdir -p "$HOME_DIR"
        fi

        if [ $# -le 2 ]; then
            # No extra paths — remove the file if it exists
            rm -f "$PATHS_FILE"
        else
            # Write each extra path (arguments 3+)
            > "$PATHS_FILE"
            shift 2
            for P in "$@"; do
                echo "$P" >> "$PATHS_FILE"
            done
        fi

        # Ensure correct ownership (user can read, www-data can write)
        if [ -f "$PATHS_FILE" ]; then
            OWNER=$(stat -c '%U' "$HOME_DIR")
            chown "$OWNER":www-data "$PATHS_FILE"
            chmod 640 "$PATHS_FILE"
        fi

        echo "OK"
        ;;

    update-allowed-paths)
        # Write allowed storage location paths to /etc/bbs/allowed-storage-paths.
        # Usage: bbs-ssh-helper update-allowed-paths [path1] [path2] ...
        CONFIG_DIR="/etc/bbs"
        CONFIG_FILE="$CONFIG_DIR/allowed-storage-paths"

        mkdir -p "$CONFIG_DIR"

        if [ $# -le 1 ]; then
            rm -f "$CONFIG_FILE"
        else
            > "$CONFIG_FILE"
            shift 1
            for P in "$@"; do
                echo "$P" >> "$CONFIG_FILE"
            done
        fi

        [ -f "$CONFIG_FILE" ] && chmod 644 "$CONFIG_FILE"
        echo "OK"
        ;;

    fix-download-perms)
        # Fix permissions on a download temp directory so www-data can read it
        # Usage: bbs-ssh-helper fix-download-perms <tmpdir>
        TMPDIR="${2:-}"

        if [ -z "$TMPDIR" ]; then
            echo "Usage: bbs-ssh-helper fix-download-perms <tmpdir>"
            exit 1
        fi

        # Safety: must be a download staging dir on the data volume (or legacy /tmp)
        if [[ ! "$TMPDIR" =~ ^(/var/bbs/tmp|/tmp)/bbs-download- ]]; then
            echo "Error: tmpdir must be under /var/bbs/tmp/bbs-download-* or /tmp/bbs-download-*"
            exit 1
        fi

        if [ -d "$TMPDIR" ]; then
            chgrp -R www-data "$TMPDIR"
            find "$TMPDIR" -type d -exec chmod 770 {} +
            find "$TMPDIR" -type f -exec chmod 660 {} +
        fi
        echo "OK"
        ;;

    cert-status)
        # Report the Apache TLS certificate: domain, issuer, expiry.
        # Usage: bbs-ssh-helper cert-status [domain]
        # Reads certbot's own view first; falls back to the live cert file so a
        # certificate issued by hand is still reported rather than shown as
        # "none".
        DOMAIN="${2:-}"

        if command -v certbot >/dev/null 2>&1; then
            certbot certificates ${DOMAIN:+--cert-name "$DOMAIN"} 2>/dev/null || true
        fi

        # A parseable block regardless of certbot's output format.
        LIVE_DIR="/etc/letsencrypt/live"
        if [ -n "$DOMAIN" ] && [ -f "$LIVE_DIR/$DOMAIN/cert.pem" ]; then
            CERT="$LIVE_DIR/$DOMAIN/cert.pem"
        else
            CERT="$(ls -1 "$LIVE_DIR"/*/cert.pem 2>/dev/null | head -1 || true)"
        fi

        if [ -n "$CERT" ] && [ -f "$CERT" ]; then
            echo "---BBS-CERT---"
            echo "path=$CERT"
            echo "subject=$(openssl x509 -in "$CERT" -noout -subject 2>/dev/null | sed 's/^subject=//')"
            echo "issuer=$(openssl x509 -in "$CERT" -noout -issuer 2>/dev/null | sed 's/^issuer=//')"
            echo "not_after=$(openssl x509 -in "$CERT" -noout -enddate 2>/dev/null | sed 's/^notAfter=//')"
            echo "domains=$(openssl x509 -in "$CERT" -noout -ext subjectAltName 2>/dev/null | tr -d ' ' | grep -o 'DNS:[^,]*' | sed 's/DNS://' | paste -sd, -)"
        else
            echo "---BBS-CERT---"
            echo "path="
        fi

        # The renewal timer is what actually keeps the certificate alive, so
        # say whether it is armed rather than only when the cert expires.
        if systemctl list-timers --all 2>/dev/null | grep -q certbot; then
            echo "timer=active"
        elif [ -f /etc/cron.d/certbot ]; then
            echo "timer=cron"
        else
            echo "timer=none"
        fi
        ;;

    cert-renew)
        # Renew now. Usage: bbs-ssh-helper cert-renew [domain] [--force]
        # Output is returned verbatim to the caller — certbot explains its own
        # failures better than a summary would.
        DOMAIN="${2:-}"
        FORCE="${3:-}"

        if ! command -v certbot >/dev/null 2>&1; then
            echo "Error: certbot is not installed on this server"
            exit 1
        fi

        ARGS="renew"
        [ -n "$DOMAIN" ] && ARGS="$ARGS --cert-name $DOMAIN"
        [ "$FORCE" = "--force" ] && ARGS="$ARGS --force-renewal"

        # shellcheck disable=SC2086
        certbot $ARGS --non-interactive 2>&1
        RC=$?
        if [ $RC -eq 0 ]; then
            apache2ctl configtest >/dev/null 2>&1 && systemctl reload apache2 >/dev/null 2>&1 || true
        fi
        exit $RC
        ;;

    cert-email)
        # Set the Let's Encrypt account contact address.
        # Usage: bbs-ssh-helper cert-email <address|--remove>
        # The installer runs before the admin account exists, so it registers
        # with whatever it was given (often nothing). This is how the address
        # collected later in the panel reaches the ACME account.
        ADDR="${2:-}"

        if [ -z "$ADDR" ]; then
            echo "Usage: bbs-ssh-helper cert-email <address|--remove>"
            exit 1
        fi
        if ! command -v certbot >/dev/null 2>&1; then
            echo "Error: certbot is not installed on this server"
            exit 1
        fi

        if [ "$ADDR" = "--remove" ]; then
            certbot update_account --register-unsafely-without-email --non-interactive 2>&1
            exit $?
        fi

        case "$ADDR" in
            *@*.*) : ;;
            *) echo "Error: '$ADDR' is not an email address"; exit 1 ;;
        esac

        certbot update_account --email "$ADDR" --non-interactive 2>&1
        exit $?
        ;;

    *)
        # Self-maintaining action list — the old hardcoded usage string went
        # stale as subcommands were added, which made "unknown action" errors
        # (usually an outdated installed helper, #342) very confusing.
        echo "Error: unknown action '${ACTION}'"
        echo "This usually means BBS components are out of sync — update to the latest release (Settings -> Update, or restart the Docker container) to bring everything current."
        echo "Available actions:"
        grep -oE '^    [a-z][a-z0-9-]*\)' "$0" | tr -d ' )' | sort | sed 's/^/  /'
        exit 1
        ;;
esac
