#!/usr/bin/env bash
#
# BBS SSH Helper — runs as root via sudo to manage Unix users for borg SSH access.
#
# Usage:
#   bbs-ssh-helper create-user <username> <home_dir> <public_key>
#   bbs-ssh-helper create-repo-dir <repo_dir>
#   bbs-ssh-helper borg-init <repo_path> <encryption> [passphrase]
#   bbs-ssh-helper borg-passphrase <username> <repo_path>   (old/new on stdin)
#   bbs-ssh-helper delete-user <username>
#   bbs-ssh-helper cert-status [domain]
#   bbs-ssh-helper cert-renew [domain] [--force]
#   bbs-ssh-helper cert-email <address|--remove>
#   bbs-ssh-helper install-gate
#   bbs-ssh-helper update-all-keys
#
# Install:
#   cp bin/bbs-ssh-helper /usr/local/bin/bbs-ssh-helper
#   chmod 755 /usr/local/bin/bbs-ssh-helper
#   echo "www-data ALL=(root) NOPASSWD: /usr/local/bin/bbs-ssh-helper, /var/www/bbs/bin/bbs-update" > /etc/sudoers.d/bbs-ssh-helper
#
set -euo pipefail

ACTION="${1:-}"

# Check if a path is under /var/bbs/ or a registered storage location.
# Paths are canonicalized with readlink -m (resolves symlinks and `..`
# segments without requiring the path to exist) before the allow-list
# check, so crafted inputs like `/var/bbs/../etc/shadow` cannot bypass
# the prefix match.
is_allowed_path() {
    local CHECK_PATH="$1"

    # Must be an absolute path
    [ -z "$CHECK_PATH" ] && return 1
    [[ "$CHECK_PATH" != /* ]] && return 1

    # Canonicalize — symlinks resolved, .. collapsed, no existence required
    local NORMALIZED
    NORMALIZED=$(readlink -m "$CHECK_PATH" 2>/dev/null || echo "")
    [ -z "$NORMALIZED" ] && return 1

    # Defense in depth — readlink -m should never leave `..` behind
    [[ "$NORMALIZED" == *"/../"* ]] && return 1
    [[ "$NORMALIZED" == *"/.." ]] && return 1

    # Check against allow-list
    [[ "$NORMALIZED" =~ ^/var/bbs(/|$) ]] && return 0
    if [ -f /etc/bbs/allowed-storage-paths ]; then
        while IFS= read -r allowed_path; do
            [ -z "$allowed_path" ] && continue
            # An entry such as "/" or a system directory (written before
            # update-allowed-paths validated its input) is ignored.
            is_safe_storage_root "$allowed_path" || continue
            local ALLOWED_NORM
            ALLOWED_NORM=$(readlink -m "$allowed_path" 2>/dev/null || echo "$allowed_path")
            [[ "$NORMALIZED" == "$ALLOWED_NORM" ]] && return 0
            [[ "$NORMALIZED" == "$ALLOWED_NORM"/* ]] && return 0
        done < /etc/bbs/allowed-storage-paths
    fi
    return 1
}

# Is this a directory that may be registered as a storage root? Absolute,
# canonical, and not the filesystem root or a system directory:
# every subcommand trusts the allow-list built from these, so one bad entry
# would open the whole filesystem to root operations.
is_safe_storage_root() {
    local P
    [[ "${1:-}" == /* ]] || return 1
    P=$(readlink -m "$1" 2>/dev/null) || return 1
    case "$P" in
        /|/bin|/bin/*|/boot|/boot/*|/dev|/dev/*|/etc|/etc/*|/lib|/lib/*|/lib32|/lib32/*|/lib64|/lib64/*|/libx32|/libx32/*|\
        /proc|/proc/*|/root|/root/*|/run|/run/*|/sbin|/sbin/*|/sys|/sys/*|/usr|/usr/*|/var|/var/lib|/var/lib/*|\
        /var/log|/var/log/*|/var/www|/var/www/*|/var/spool|/var/spool/*|/var/cache|/var/cache/*|/home|/tmp|/opt|/srv|/mnt|/media)
            return 1 ;;
    esac
    return 0
}

# A client's home directory: <base>/<numeric agent id>, not a symlink, with
# a base that is not a system directory. Homes live under the storage_path
# setting, which need not be a registered storage location.
is_client_home() {
    local P
    [[ "${1:-}" == /* ]] || return 1
    [ -L "$1" ] && return 1
    P=$(readlink -m "$1" 2>/dev/null) || return 1
    [[ "$(basename "$P")" =~ ^[0-9]+$ ]] || return 1
    is_safe_storage_root "$(dirname "$P")" || [[ "$(dirname "$P")" =~ ^/var/bbs(/|$) ]]
}

case "$ACTION" in
    create-user)
        USERNAME="${2:-}"
        HOME_DIR="${3:-}"
        PUBLIC_KEY="${4:-}"

        if [ -z "$USERNAME" ] || [ -z "$HOME_DIR" ] || [ -z "$PUBLIC_KEY" ]; then
            echo "Usage: bbs-ssh-helper create-user <username> <home_dir> <public_key>"
            exit 1
        fi

        # Validate username format (must start with bbs-)
        if [[ ! "$USERNAME" =~ ^bbs-[a-z0-9_-]+$ ]]; then
            echo "Error: username must match bbs-[a-z0-9_-]+"
            exit 1
        fi

        if ! is_client_home "$HOME_DIR"; then
            echo "Error: home dir must be <storage path>/<client id>, not a symlink or system directory"
            exit 1
        fi

        # Create home directory if needed
        mkdir -p "$HOME_DIR"

        # Create user with no password, no login shell, home at storage path
        if id "$USERNAME" &>/dev/null; then
            echo "User $USERNAME already exists"
        else
            useradd --shell /bin/sh --home-dir "$HOME_DIR" --no-create-home "$USERNAME"
            echo "Created user: $USERNAME"
        fi

        # Set ownership: user owns, www-data group for server-side borg operations (init, prune, compact)
        # This MUST succeed — sshd requires correct ownership of home/.ssh for key auth.
        # If this fails (e.g. NAS/NFS mount), the SSH home dir must be on a local filesystem.
        if ! chown "$USERNAME":www-data "$HOME_DIR" 2>&1; then
            echo "Error: chown failed on $HOME_DIR — SSH home directories must be on a local filesystem, not a NAS/NFS mount. Check your storage_path setting."
            exit 1
        fi
        chmod 750 "$HOME_DIR"

        # Add user to www-data group so catalog files can be chgrp'd to www-data
        # (needed on FUSE/shfs filesystems like Unraid where setgid is not honored)
        usermod -a -G www-data "$USERNAME" 2>/dev/null || true

        # Configure SSH authorized_keys with gate dispatcher
        SSH_DIR="$HOME_DIR/.ssh"
        mkdir -p "$SSH_DIR"
        chmod 700 "$SSH_DIR"

        AUTHORIZED_KEYS="$SSH_DIR/authorized_keys"
        RESTRICT_CMD="command=\"/usr/local/bin/bbs-ssh-gate $HOME_DIR\",restrict"

        echo "$RESTRICT_CMD $PUBLIC_KEY" > "$AUTHORIZED_KEYS"
        chmod 600 "$AUTHORIZED_KEYS"
        chown -R "$USERNAME":"$USERNAME" "$SSH_DIR"

        # Create catalog log directory with setgid so files inherit www-data group
        CATALOG_DIR="$HOME_DIR/.catalog-logs"
        mkdir -p "$CATALOG_DIR"
        chown "$USERNAME":www-data "$CATALOG_DIR"
        chmod 2770 "$CATALOG_DIR"

        echo "OK"
        ;;

    create-repo-dir)
        REPO_DIR="${2:-}"

        if [ -z "$REPO_DIR" ]; then
            echo "Usage: bbs-ssh-helper create-repo-dir <repo_dir>"
            exit 1
        fi

        if ! is_allowed_path "$REPO_DIR"; then
            echo "Error: repo dir must be under /var/bbs/ or a registered storage location"
            exit 1
        fi

        # Check if parent needs to be created (e.g., /var/bbs/home/3/ for user's home)
        PARENT_DIR=$(dirname "$REPO_DIR")
        if [ ! -d "$PARENT_DIR" ]; then
            # Parent doesn't exist - need to create and set ownership
            # For paths like /var/bbs/home/3/reponame, the parent is the user's home
            mkdir -p "$PARENT_DIR"
        fi

        # Create the repo directory
        mkdir -p "$REPO_DIR"

        # Find the bbs-* user who owns the parent directory.
        # On NFS with admin mapping, stat may return UNKNOWN or the NFS-mapped user,
        # so we also search by path when the owner isn't a bbs-* user.
        PARENT_OWNER=$(stat -c '%U' "$PARENT_DIR")

        if [[ ! "$PARENT_OWNER" =~ ^bbs- ]]; then
            # Parent not owned by a bbs-* user (could be root, UNKNOWN, or NFS-mapped).
            # Try to find the correct bbs-* user by matching the directory path.
            ACTUAL_USER=$(awk -F: -v home="$PARENT_DIR" '$6 == home && $1 ~ /^bbs-/ {print $1}' /etc/passwd)
            if [ -z "$ACTUAL_USER" ]; then
                BASENAME=$(basename "$PARENT_DIR")
                if [[ "$BASENAME" =~ ^[0-9]+$ ]]; then
                    ACTUAL_USER=$(awk -F: -v aid="/$BASENAME" '$6 ~ aid"$" && $1 ~ /^bbs-/ {print $1}' /etc/passwd)
                fi
            fi
            if [ -n "$ACTUAL_USER" ]; then
                PARENT_OWNER="$ACTUAL_USER"
            fi
        fi

        # Set ownership (may fail on NFS with admin mapping — non-fatal)
        if [[ "$PARENT_OWNER" =~ ^bbs- ]]; then
            chown "$PARENT_OWNER":www-data "$PARENT_DIR" 2>/dev/null || true
            chmod 750 "$PARENT_DIR" 2>/dev/null || true
            chown "$PARENT_OWNER":www-data "$REPO_DIR" 2>/dev/null || true
        fi
        chmod 770 "$REPO_DIR" 2>/dev/null || true
        echo "OK"
        ;;

    borg-extract)
        # Run borg extract as the repo-owning user
        # Usage: bbs-ssh-helper borg-extract <username> <tmpdir> <passphrase|-> <repo::archive> [paths...]
        # When <passphrase> is "-", the passphrase is read from the first
        # line of stdin (avoids argv/`ps` exposure).
        USERNAME="${2:-}"
        TMPDIR="${3:-}"
        PASSPHRASE="${4:-}"
        shift 4 2>/dev/null || true
        if [ "$PASSPHRASE" = "-" ]; then IFS= read -r PASSPHRASE || PASSPHRASE=""; fi

        if [ -z "$USERNAME" ] || [ -z "$TMPDIR" ] || [ $# -eq 0 ]; then
            echo "Usage: bbs-ssh-helper borg-extract <username> <tmpdir> <passphrase> <repo::archive> [paths...]"
            exit 1
        fi

        if [[ ! "$USERNAME" =~ ^bbs-[a-z0-9_-]+$ ]]; then
            echo "Error: username must match bbs-[a-z0-9_-]+"
            exit 1
        fi

        # Safety: staging must be a bbs-download-/bbs-restore- directory under
        # the data volume's tmp (preferred, #344) or legacy /tmp. Checked on
        # the canonical path so "/tmp/../etc" cannot pass, and not a symlink.
        if [ -L "$TMPDIR" ] || [[ ! "$(readlink -m "$TMPDIR")" =~ ^(/var/bbs/tmp|/tmp)/bbs-(download|restore)-[A-Za-z0-9]+$ ]]; then
            echo "Error: tmpdir must be /var/bbs/tmp/bbs-download-* (or /tmp/bbs-download-*)"
            exit 1
        fi
        TMPDIR=$(readlink -m "$TMPDIR")

        # Ensure tmpdir exists and is writable by the user
        mkdir -p "$TMPDIR"
        chown "$USERNAME":www-data "$TMPDIR"
        chmod 770 "$TMPDIR"

        # Per-user borg cache dir (matches scheduler.php and bbs-update)
        BORG_DIR="/var/bbs/cache/$USERNAME"
        mkdir -p "$BORG_DIR"
        chown "$USERNAME":"$USERNAME" "$BORG_DIR"

        # Run borg extract as the repo-owning user
        cd "$TMPDIR"
        sudo -u "$USERNAME" \
            BORG_PASSPHRASE="$PASSPHRASE" \
            BORG_UNKNOWN_UNENCRYPTED_REPO_ACCESS_IS_OK=yes \
            BORG_RELOCATED_REPO_ACCESS_IS_OK=yes \
            BORG_BASE_DIR="$BORG_DIR" \
            HOME="$BORG_DIR" \
            borg extract "$@" 2>&1

        EXIT_CODE=$?

        # Make extracted files readable by www-data for tar/streaming
        # Redirect to /dev/null to avoid SIGPIPE if caller closed the pipe
        chown -R "$USERNAME":www-data "$TMPDIR" >/dev/null 2>&1
        find "$TMPDIR" -type d -exec chmod 770 {} + >/dev/null 2>&1
        find "$TMPDIR" -type f -exec chmod 660 {} + >/dev/null 2>&1

        exit $EXIT_CODE
        ;;

    verify-repo)
        # Verify a borg repo exists and return JSON (encryption mode, archive list).
        # Runs as root since repo may have arbitrary ownership before import.
        # Usage: bbs-ssh-helper verify-repo <passphrase|-> <repo_path>
        PASSPHRASE="${2:-}"
        REPO_PATH="${3:-}"
        if [ "$PASSPHRASE" = "-" ]; then IFS= read -r PASSPHRASE || PASSPHRASE=""; fi

        if [ -z "$REPO_PATH" ]; then
            echo "Usage: bbs-ssh-helper verify-repo <passphrase> <repo_path>"
            exit 1
        fi

        if ! is_allowed_path "$REPO_PATH"; then
            echo "Error: repo path must be under /var/bbs/ or a registered storage location"
            exit 1
        fi

        mkdir -p /tmp/bbs-verify

        # Do NOT use 2>&1 here — borg's first-run cache initialization and
        # security info messages on stderr corrupt the JSON output, causing
        # json_decode in PHP to fail and the import button to "not find" the
        # repo on the first click. The PHP caller captures stdout and stderr
        # on separate pipes, so leave them separated.
        BORG_PASSPHRASE="$PASSPHRASE" \
        BORG_UNKNOWN_UNENCRYPTED_REPO_ACCESS_IS_OK=yes \
        BORG_RELOCATED_REPO_ACCESS_IS_OK=yes \
        BORG_BASE_DIR="/tmp/bbs-verify" \
        HOME="/tmp/bbs-verify" \
            borg list --json "$REPO_PATH"

        exit $?
        ;;

    find-repos)
        # Walk a storage path and list borg repositories as JSON lines:
        #   {"path":"...","name":"...","size_bytes":N,"mtime":N,"key_in_repo":0|1,"device":"..."}
        # A borg repo is a directory holding a `config` file with a
        # [repository] section and a `data` subdirectory. key_in_repo=1
        # means repokey-style encryption (key stored inside the repo);
        # 0 means unencrypted OR keyfile mode (key lives elsewhere).
        # Usage: bbs-ssh-helper find-repos <base_path>
        BASE_PATH="${2:-}"

        if [ -z "$BASE_PATH" ]; then
            echo "Usage: bbs-ssh-helper find-repos <base_path>"
            exit 1
        fi
        if ! is_allowed_path "$BASE_PATH"; then
            echo "Error: base path must be under /var/bbs/ or a registered storage location"
            exit 1
        fi
        if [ ! -d "$BASE_PATH" ]; then
            echo "Error: base path does not exist: $BASE_PATH"
            exit 1
        fi

        # -maxdepth 6 bounds the walk; repos normally sit 2 levels deep
        # (<loc>/<agent_id>/<name>) but disaster-recovery copies can be
        # nested under extra folders.
        find "$BASE_PATH" -maxdepth 6 -type f -name config 2>/dev/null | while IFS= read -r CFG; do
            REPO_DIR=$(dirname "$CFG")
            [ -d "$REPO_DIR/data" ] || continue
            grep -q '^\[repository\]' "$CFG" 2>/dev/null || continue

            SIZE=$(du -sb "$REPO_DIR" 2>/dev/null | cut -f1)
            MTIME=$(stat -c %Y "$REPO_DIR" 2>/dev/null || echo 0)
            DEVICE=$(stat -c %d "$REPO_DIR" 2>/dev/null || echo 0)
            KEY_IN_REPO=0
            grep -q '^key = ' "$CFG" 2>/dev/null && KEY_IN_REPO=1
            NAME=$(basename "$REPO_DIR")

            printf '{"path":"%s","name":"%s","size_bytes":%s,"mtime":%s,"key_in_repo":%s,"device":"%s"}\n' \
                "$REPO_DIR" "$NAME" "${SIZE:-0}" "${MTIME:-0}" "$KEY_IN_REPO" "$DEVICE"
        done
        exit 0
        ;;

    check-move)
        # Report whether moving a repo from <src> to <dst> is a same-filesystem
        # rename or a cross-filesystem copy, and whether space suffices.
        # <dst> does not need to exist — the nearest existing ancestor is used
        # for the filesystem/space check.
        # Output JSON: {"src_bytes":N,"same_fs":0|1,"free_bytes":N,"fits":0|1}
        # Usage: bbs-ssh-helper check-move <src> <dst>
        SRC="${2:-}"
        DST="${3:-}"

        if [ -z "$SRC" ] || [ -z "$DST" ]; then
            echo "Usage: bbs-ssh-helper check-move <src> <dst>"
            exit 1
        fi
        if ! is_allowed_path "$SRC" || ! is_allowed_path "$DST"; then
            echo "Error: paths must be under /var/bbs/ or a registered storage location"
            exit 1
        fi
        if [ ! -d "$SRC" ]; then
            echo "Error: source does not exist: $SRC"
            exit 1
        fi

        DST_CHECK=$(readlink -m "$DST")
        while [ ! -d "$DST_CHECK" ] && [ "$DST_CHECK" != "/" ]; do
            DST_CHECK=$(dirname "$DST_CHECK")
        done

        SRC_BYTES=$(du -sb "$SRC" 2>/dev/null | cut -f1)
        SRC_DEV=$(stat -c %d "$SRC")
        DST_DEV=$(stat -c %d "$DST_CHECK")
        FREE_BYTES=$(df -P -B1 "$DST_CHECK" | awk 'NR==2 {print $4}')

        SAME_FS=0
        [ "$SRC_DEV" = "$DST_DEV" ] && SAME_FS=1

        # A rename needs no space; a copy needs the full repo size plus 2%
        # slack for filesystem overhead.
        FITS=1
        if [ "$SAME_FS" = "0" ]; then
            REQUIRED=$(( SRC_BYTES + SRC_BYTES / 50 ))
            [ "$FREE_BYTES" -lt "$REQUIRED" ] && FITS=0
        fi

        printf '{"src_bytes":%s,"same_fs":%s,"free_bytes":%s,"fits":%s}\n' \
            "${SRC_BYTES:-0}" "$SAME_FS" "${FREE_BYTES:-0}" "$FITS"
        exit 0
        ;;

    move-repo)
        # Move a borg repository into its canonical location. Same-filesystem
        # moves are an instant rename; cross-filesystem moves copy first and
        # delete the source only after the copy fully succeeds, so a failure
        # can never lose the original repo.
        # Usage: bbs-ssh-helper move-repo <src> <dst>
        SRC="${2:-}"
        DST="${3:-}"

        if [ -z "$SRC" ] || [ -z "$DST" ]; then
            echo "Usage: bbs-ssh-helper move-repo <src> <dst>"
            exit 1
        fi
        if ! is_allowed_path "$SRC" || ! is_allowed_path "$DST"; then
            echo "Error: paths must be under /var/bbs/ or a registered storage location"
            exit 1
        fi
        if [ ! -d "$SRC" ]; then
            echo "Error: source does not exist: $SRC"
            exit 1
        fi
        if [ ! -f "$SRC/config" ] || ! grep -q '^\[repository\]' "$SRC/config" 2>/dev/null; then
            echo "Error: source is not a borg repository: $SRC"
            exit 1
        fi
        SRC_NORM=$(readlink -m "$SRC")
        DST_NORM=$(readlink -m "$DST")
        if [ "$SRC_NORM" = "$DST_NORM" ]; then
            echo "Error: source and destination are the same path"
            exit 1
        fi
        if [ -e "$DST_NORM" ]; then
            echo "Error: destination already exists: $DST_NORM"
            exit 1
        fi

        mkdir -p "$(dirname "$DST_NORM")"

        SRC_DEV=$(stat -c %d "$SRC_NORM")
        DST_DEV=$(stat -c %d "$(dirname "$DST_NORM")")

        if [ "$SRC_DEV" = "$DST_DEV" ]; then
            mv "$SRC_NORM" "$DST_NORM"
            echo "moved (rename): $SRC_NORM -> $DST_NORM"
        else
            # Re-check space right before the copy
            SRC_BYTES=$(du -sb "$SRC_NORM" | cut -f1)
            FREE_BYTES=$(df -P -B1 "$(dirname "$DST_NORM")" | awk 'NR==2 {print $4}')
            REQUIRED=$(( SRC_BYTES + SRC_BYTES / 50 ))
            if [ "$FREE_BYTES" -lt "$REQUIRED" ]; then
                echo "Error: not enough space at destination (need ${REQUIRED} bytes, have ${FREE_BYTES})"
                exit 1
            fi
            if ! cp -a "$SRC_NORM" "$DST_NORM"; then
                rm -rf "$DST_NORM"
                echo "Error: copy failed — destination cleaned up, source untouched"
                exit 1
            fi
            rm -rf "$SRC_NORM"
            echo "moved (copy): $SRC_NORM -> $DST_NORM"
        fi
        exit 0
        ;;

    borg-list)
        # Run borg list as the repo-owning user
        # Usage: bbs-ssh-helper borg-list <username> <passphrase|-> <repo_path>
        USERNAME="${2:-}"
        PASSPHRASE="${3:-}"
        REPO_PATH="${4:-}"
        if [ "$PASSPHRASE" = "-" ]; then IFS= read -r PASSPHRASE || PASSPHRASE=""; fi

        if [ -z "$USERNAME" ] || [ -z "$REPO_PATH" ]; then
            echo "Usage: bbs-ssh-helper borg-list <username> <passphrase> <repo_path>"
            exit 1
        fi

        if [[ ! "$USERNAME" =~ ^bbs-[a-z0-9_-]+$ ]]; then
            echo "Error: username must match bbs-[a-z0-9_-]+"
            exit 1
        fi

        if ! is_allowed_path "$REPO_PATH"; then
            echo "Error: repo path must be under /var/bbs/ or a registered storage location"
            exit 1
        fi

        # Per-user borg cache dir
        BORG_DIR="/var/bbs/cache/$USERNAME"
        mkdir -p "$BORG_DIR"
        chown "$USERNAME":"$USERNAME" "$BORG_DIR"

        # Run borg list --json as the repo-owning user
        # Do NOT use 2>&1 here — borg warnings on stderr corrupt the JSON output
        # and cause json_decode to fail, which can wipe all archive records.
        # --lock-wait: wait up to 10 min for the repo lock rather than failing
        # immediately when a concurrent backup/compact is in progress.
        sudo -u "$USERNAME" \
            BORG_PASSPHRASE="$PASSPHRASE" \
            BORG_UNKNOWN_UNENCRYPTED_REPO_ACCESS_IS_OK=yes \
            BORG_RELOCATED_REPO_ACCESS_IS_OK=yes \
            BORG_BASE_DIR="$BORG_DIR" \
            HOME="$BORG_DIR" \
            borg list --lock-wait 600 --json "$REPO_PATH"

        exit $?
        ;;

    borg-list-archive)
        # List files in a specific archive (for catalog rebuild)
        # Usage: bbs-ssh-helper borg-list-archive <username> <passphrase|-> <repo_path>::<archive_name>
        # Output: JSON array of file paths
        USERNAME="${2:-}"
        PASSPHRASE="${3:-}"
        ARCHIVE_PATH="${4:-}"
        if [ "$PASSPHRASE" = "-" ]; then IFS= read -r PASSPHRASE || PASSPHRASE=""; fi

        if [ -z "$USERNAME" ] || [ -z "$ARCHIVE_PATH" ]; then
            echo "Usage: bbs-ssh-helper borg-list-archive <username> <passphrase> <repo::archive>"
            exit 1
        fi

        if [[ ! "$USERNAME" =~ ^bbs-[a-z0-9_-]+$ ]]; then
            echo "Error: username must match bbs-[a-z0-9_-]+"
            exit 1
        fi

        # Extract repo path from archive path (before ::)
        REPO_PATH="${ARCHIVE_PATH%%::*}"

        if ! is_allowed_path "$REPO_PATH"; then
            echo "Error: repo path must be under /var/bbs/ or a registered storage location"
            exit 1
        fi

        # Per-user borg cache dir
        BORG_DIR="/var/bbs/cache/$USERNAME"
        mkdir -p "$BORG_DIR"
        chown "$USERNAME":"$USERNAME" "$BORG_DIR"

        # Run borg list on archive with JSON output (paths only)
        # --lock-wait: wait up to 10 min for the repo lock rather than failing
        # immediately when a concurrent backup/compact is in progress.
        sudo -u "$USERNAME" \
            BORG_PASSPHRASE="$PASSPHRASE" \
            BORG_UNKNOWN_UNENCRYPTED_REPO_ACCESS_IS_OK=yes \
            BORG_RELOCATED_REPO_ACCESS_IS_OK=yes \
            BORG_BASE_DIR="$BORG_DIR" \
            HOME="$BORG_DIR" \
            borg list --lock-wait 600 --json-lines "$ARCHIVE_PATH" 2>&1

        exit $?
        ;;

    borg-cmd)
        # Run one of the allow-listed borg subcommands as the repo-owning user
        # Usage: bbs-ssh-helper borg-cmd <username> <passphrase|-> <borg-subcommand> [args...]
        # When <passphrase> is "-", the passphrase is read from the first
        # line of stdin (avoids argv/`ps` exposure).
        USERNAME="${2:-}"
        PASSPHRASE="${3:-}"
        shift 3 2>/dev/null || true
        if [ "$PASSPHRASE" = "-" ]; then IFS= read -r PASSPHRASE || PASSPHRASE=""; fi
        # Remaining args are the borg subcommand and its arguments

        if [ -z "$USERNAME" ] || [ $# -eq 0 ]; then
            echo "Usage: bbs-ssh-helper borg-cmd <username> <passphrase> <borg-subcommand> [args...]"
            exit 1
        fi

        if [[ ! "$USERNAME" =~ ^bbs-[a-z0-9_-]+$ ]]; then
            echo "Error: username must match bbs-[a-z0-9_-]+"
            exit 1
        fi

        # Allowlist borg subcommands this wrapper is permitted to run. Any
        # other subcommand — including init, extract, list (have dedicated
        # wrappers), create, mount, serve, export-tar, config — is rejected.
        BORG_SUBCMD="$1"
        case "$BORG_SUBCMD" in
            prune|compact|check|break-lock|delete|info|rename) ;;
            *)
                echo "Error: borg subcommand '$BORG_SUBCMD' is not permitted via borg-cmd"
                exit 1
                ;;
        esac

        # Reject flags that can reshape borg's execution environment:
        # --rsh lets the caller specify an arbitrary SSH/shell command,
        # --remote-path lets them point at an alternate borg binary, and
        # --debug-profile writes debug dumps to an arbitrary path.
        for arg in "$@"; do
            case "$arg" in
                --rsh|--rsh=*|--remote-path|--remote-path=*|--debug-profile|--debug-profile=*)
                    echo "Error: flag '$arg' is not permitted"
                    exit 1
                    ;;
            esac
        done

        # Validate that at least one arg is an allowed path
        FOUND_ALLOWED_PATH=false
        for arg in "$@"; do
            # Strip any ::archive suffix so the path portion can be checked
            PATH_ONLY="${arg%%::*}"
            if is_allowed_path "$PATH_ONLY"; then
                FOUND_ALLOWED_PATH=true
                break
            fi
        done
        if [ "$FOUND_ALLOWED_PATH" = false ]; then
            echo "Error: borg command must include a path under /var/bbs/ or a registered storage location"
            exit 1
        fi

        # Per-user borg cache dir
        BORG_DIR="/var/bbs/cache/$USERNAME"
        mkdir -p "$BORG_DIR"
        chown "$USERNAME":"$USERNAME" "$BORG_DIR"

        # Inject --lock-wait so server-side ops (compact/prune/check/info/
        # delete) wait up to 10 min for the repo lock rather than failing
        # immediately when an agent backup or another server-side task is
        # still holding it. break-lock is the only allow-listed subcommand
        # where --lock-wait is meaningless, so skip injection in that case.
        SUBCMD="$1"; shift
        if [ "$SUBCMD" = "break-lock" ]; then
            BORG_EXTRA_OPTS=()
        else
            BORG_EXTRA_OPTS=(--lock-wait 600)
        fi

        # Run borg command as the repo-owning user. BORG_CHECK_I_KNOW_WHAT_I_AM_DOING=YES
        # is only consulted when `borg check --repair` runs (skips its interactive
        # 'YES' prompt that would otherwise block server-side repair jobs); harmless
        # on every other subcommand.
        sudo -u "$USERNAME" \
            BORG_PASSPHRASE="$PASSPHRASE" \
            BORG_CHECK_I_KNOW_WHAT_I_AM_DOING=YES \
            BORG_UNKNOWN_UNENCRYPTED_REPO_ACCESS_IS_OK=yes \
            BORG_RELOCATED_REPO_ACCESS_IS_OK=yes \
            BORG_BASE_DIR="$BORG_DIR" \
            HOME="$BORG_DIR" \
            borg "$SUBCMD" "${BORG_EXTRA_OPTS[@]}" "$@" 2>&1

        exit $?
        ;;

    borg-passphrase)
        # Change a repository's passphrase (#412).
        # Usage: bbs-ssh-helper borg-passphrase <username> <repo_path>
        #        old and new passphrases on stdin, one per line.
        #
        # Not part of borg-cmd: that wrapper takes a single passphrase and an
        # allow-list this subcommand is deliberately absent from, and passing a
        # second secret through it would widen an interface used by everything
        # else.
        USERNAME="${2:-}"
        REPO_PATH="${3:-}"

        if [ -z "$USERNAME" ] || [ -z "$REPO_PATH" ]; then
            echo "Usage: bbs-ssh-helper borg-passphrase <username> <repo_path>  (passphrases on stdin)"
            exit 1
        fi
        if [[ ! "$USERNAME" =~ ^bbs-[a-z0-9_-]+$ ]]; then
            echo "Error: username must match bbs-[a-z0-9_-]+"
            exit 1
        fi
        if ! is_allowed_path "$REPO_PATH"; then
            echo "Error: repo path must be under /var/bbs/ or a registered storage location"
            exit 1
        fi

        # Read both secrets from stdin so neither appears in argv or `ps`.
        IFS= read -r OLD_PP || OLD_PP=""
        IFS= read -r NEW_PP || NEW_PP=""
        if [ -z "$NEW_PP" ]; then
            echo "Error: new passphrase is empty"
            exit 1
        fi

        BORG_DIR="/var/bbs/cache/$USERNAME"
        mkdir -p "$BORG_DIR"
        chown "$USERNAME":"$USERNAME" "$BORG_DIR"

        # --lock-wait is short on purpose. The caller has already checked that
        # no job is using this repository; if something took the lock in the
        # meantime, failing quickly is better than holding the request open for
        # ten minutes while a backup runs.
        sudo -u "$USERNAME" \
            BORG_PASSPHRASE="$OLD_PP" \
            BORG_NEW_PASSPHRASE="$NEW_PP" \
            BORG_UNKNOWN_UNENCRYPTED_REPO_ACCESS_IS_OK=yes \
            BORG_RELOCATED_REPO_ACCESS_IS_OK=yes \
            BORG_BASE_DIR="$BORG_DIR" \
            HOME="$BORG_DIR" \
            borg key change-passphrase -v --lock-wait 30 "$REPO_PATH" 2>&1

        exit $?
        ;;

    borg-init)
        # Run borg init as root so it works on NFS and other filesystems where
        # www-data may not have write access despite correct POSIX permissions.
        # Usage: bbs-ssh-helper borg-init <repo_path> <encryption> [passphrase|-]
        REPO_PATH="${2:-}"
        ENCRYPTION="${3:-}"
        PASSPHRASE="${4:-}"
        if [ "$PASSPHRASE" = "-" ]; then IFS= read -r PASSPHRASE || PASSPHRASE=""; fi

        if [ -z "$REPO_PATH" ] || [ -z "$ENCRYPTION" ]; then
            echo "Usage: bbs-ssh-helper borg-init <repo_path> <encryption> [passphrase]"
            exit 1
        fi

        if ! is_allowed_path "$REPO_PATH"; then
            echo "Error: repo path must be under /var/bbs/ or a registered storage location"
            exit 1
        fi

        # Validate encryption mode
        case "$ENCRYPTION" in
            none|repokey|repokey-blake2|keyfile|keyfile-blake2|authenticated|authenticated-blake2)
                ;;
            *)
                echo "Error: invalid encryption mode: $ENCRYPTION"
                exit 1
                ;;
        esac

        mkdir -p /tmp/bbs-borg-init

        BORG_PASSPHRASE="$PASSPHRASE" \
        BORG_UNKNOWN_UNENCRYPTED_REPO_ACCESS_IS_OK=yes \
        BORG_RELOCATED_REPO_ACCESS_IS_OK=yes \
        BORG_BASE_DIR="/tmp/bbs-borg-init" \
        HOME="/tmp/bbs-borg-init" \
            borg init "--encryption=$ENCRYPTION" "$REPO_PATH" 2>&1

        exit $?
        ;;

    fix-repo-perms)
        REPO_DIR="${2:-}"
        USERNAME="${3:-}"

        if [ -z "$REPO_DIR" ] || [ -z "$USERNAME" ]; then
            echo "Usage: bbs-ssh-helper fix-repo-perms <repo_dir> <username>"
            exit 1
        fi

        if ! is_allowed_path "$REPO_DIR"; then
            echo "Error: repo dir must be under /var/bbs/ or a registered storage location"
            exit 1
        fi
        if [[ ! "$USERNAME" =~ ^bbs-[a-z0-9_-]+$ ]]; then
            echo "Error: username must match bbs-[a-z0-9_-]+"
            exit 1
        fi

        if [ -d "$REPO_DIR" ]; then
            # chown may fail on NFS with admin mapping — non-fatal since
            # all users map to the same NFS user anyway
            chown -R "$USERNAME":www-data "$REPO_DIR" 2>/dev/null || true
            chmod 770 "$REPO_DIR" 2>/dev/null || true
        fi
        echo "OK"
        ;;

    delete-user)
        USERNAME="${2:-}"

        if [ -z "$USERNAME" ]; then
            echo "Usage: bbs-ssh-helper delete-user <username>"
            exit 1
        fi

        # Safety: only delete bbs- prefixed users
        if [[ ! "$USERNAME" =~ ^bbs-[a-z0-9_-]+$ ]]; then
            echo "Error: will only delete users matching bbs-[a-z0-9_-]+"
            exit 1
        fi

        if id "$USERNAME" &>/dev/null; then
            userdel "$USERNAME" 2>/dev/null || true
            echo "Deleted user: $USERNAME"
        else
            echo "User $USERNAME does not exist"
        fi

        echo "OK"
        ;;

    update-borg)
        # Download (or take from BBS's own server-hosted copies) and install a
        # borg binary to /usr/local/bin/borg. Nothing is made executable or run
        # before it has been checked.
        # Usage: bbs-ssh-helper update-borg <github_url> <expected_version> <sha256>
        #        bbs-ssh-helper update-borg <path under /var/www/bbs/public/borg> <expected_version>
        SOURCE="${2:-}"
        EXPECTED_VERSION="${3:-}"
        EXPECTED_SHA256="${4:-}"

        if [ -z "$SOURCE" ] || [ -z "$EXPECTED_VERSION" ]; then
            echo "Usage: bbs-ssh-helper update-borg <download_url|server_path> <expected_version> [sha256]"
            exit 1
        fi
        if [[ ! "$EXPECTED_VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
            echo "Error: invalid version"
            exit 1
        fi

        BORG_PATH="/usr/local/bin/borg"
        BORG_TMP=$(mktemp /usr/local/bin/.borg.XXXXXX)
        SIG_TMP=$(mktemp)
        KEYRING=$(mktemp --suffix=.gpg)
        trap 'rm -f "$BORG_TMP" "$SIG_TMP" "$KEYRING"' EXIT

        # Signing keys live in this root-owned script, not next to the
        # binaries: /var/www/bbs belongs to the web user.
        borg_release_key() {
            # Thomas Waldmann (borg releases), 6D5B EF9A DD20 7580 5747 B70F 9F88 FB52 FAF7 B393
