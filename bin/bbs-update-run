#!/usr/bin/env bash
#
# BBS Update Run — executes all post-pull update steps.
#
# Called by bbs-update after code has been pulled. Because bbs-update exec's
# this script, it always runs the freshly-pulled version regardless of what
# version of bbs-update the user originally invoked.
#
# Usage (internal — called by bbs-update):
#   bash /var/www/bbs/bin/bbs-update-run <bbs_dir>
#
set -euo pipefail

BBS_DIR="${1:-/var/www/bbs}"

# 2. Install/update PHP dependencies
echo "[2/9] Installing PHP dependencies..."
if command -v composer &>/dev/null; then
    # --no-interaction so an update never hangs on a Composer prompt (#351).
    # Composer is run through php with PCRE JIT off: in containers that
    # refuse executable memory, PHP warns "Allocation of JIT memory failed"
    # and Composer turns that warning into a fatal error (#480). The setting
    # applies to this process only; php.ini is not touched.
    export COMPOSER_ALLOW_SUPERUSER=1 COMPOSER_NO_INTERACTION=1
    if ! php -d pcre.jit=0 "$(command -v composer)" install --no-dev --working-dir="$BBS_DIR" --no-interaction --no-progress; then
        # Keep going: the migrations and permission fixes below matter more
        # than a dependency refresh, and stopping here left installs
        # half-updated (#480).
        echo ""
        echo "  ================================================================"
        echo "  COMPOSER FAILED — see the errors above."
        echo "  The code was updated and the rest of the update continues, but"
        echo "  PHP dependencies may be out of date. Once the cause is fixed, run:"
        echo "    sudo $BBS_DIR/bin/bbs-update"
        echo "  ================================================================"
        echo ""
    fi
else
    echo "  Warning: composer not found, skipping"
fi

# 3. Fix web file ownership
echo "[3/9] Checking web file permissions..."
chown -R www-data:www-data "$BBS_DIR"
chmod 755 "$BBS_DIR/config"
[ -f "$BBS_DIR/config/.env" ] && chmod 600 "$BBS_DIR/config/.env"

# 4. Update SSH helper and gate
echo "[4/9] Checking SSH helper..."
cp "$BBS_DIR/bin/bbs-ssh-helper" /usr/local/bin/bbs-ssh-helper
chmod 755 /usr/local/bin/bbs-ssh-helper
/usr/local/bin/bbs-ssh-helper install-gate
/usr/local/bin/bbs-ssh-helper update-all-keys

# 4b. Set PHP max_execution_time (default 30s is too short for large operations)
PHP_INI_DIR=$(php -i 2>/dev/null | grep -oP 'Scan this dir for additional .ini files => \K\S+' | head -1)
if [ -n "$PHP_INI_DIR" ] && [ -d "$PHP_INI_DIR" ]; then
    echo "max_execution_time = 300" > "$PHP_INI_DIR/bbs.ini"
fi

# 5. ClickHouse — ensure running and schema is current
echo "[5/9] Checking ClickHouse..."
if command -v clickhouse-server &>/dev/null; then
    # Ensure config override is in place
    mkdir -p /etc/clickhouse-server/config.d
    CH_OVERRIDE_CHANGED=0
    CH_OVERRIDE_SRC="$BBS_DIR/config/clickhouse-server-override.xml"
    CH_OVERRIDE_DST="/etc/clickhouse-server/config.d/bbs-override.xml"
    if [ -f "$BBS_DIR/config/clickhouse-server-override.xml" ]; then
        if ! cmp -s "$CH_OVERRIDE_SRC" "$CH_OVERRIDE_DST"; then
            cp "$CH_OVERRIDE_SRC" "$CH_OVERRIDE_DST"
            CH_OVERRIDE_CHANGED=1
        fi
    fi
    # Ensure service is running
    if systemctl is-active --quiet clickhouse-server; then
        if [ "$CH_OVERRIDE_CHANGED" -eq 1 ]; then
            systemctl restart clickhouse-server 2>/dev/null || true
            sleep 2
        fi
    else
        systemctl start clickhouse-server 2>/dev/null || true
        sleep 2
    fi
    # Drop system_log tables we suppress in the override. The remove="remove"
    # directive only prevents ClickHouse from *creating* these tables on
    # startup — it doesn't delete pre-existing ones. Installs predating
    # v2.53.x carry the old tables forward, and each version of ClickHouse
    # tends to add a few new ones. Idempotent drop matches entrypoint.sh
    # on the Docker side so bare-metal and Docker stay in sync.
    for tbl in trace_log text_log metric_log asynchronous_metric_log part_log \
               processors_profile_log query_log query_thread_log query_views_log \
               query_metric_log session_log opentelemetry_span_log \
               asynchronous_insert_log backup_log s3_queue_log blob_storage_log \
               background_schedule_pool_log error_log; do
        clickhouse-client --query "DROP TABLE IF EXISTS system.$tbl" 2>/dev/null || true
    done
    # Ensure database and tables exist (idempotent)
    clickhouse-client --query "CREATE DATABASE IF NOT EXISTS bbs" 2>/dev/null || true
    clickhouse-client -d bbs --multiquery < "$BBS_DIR/schema-clickhouse.sql" 2>/dev/null || true
    echo "  OK"
else
    echo "  Warning: ClickHouse not installed (catalog features unavailable)"
    echo "  Run the installer to set up ClickHouse, or reinstall BBS."
fi

# 6. Fix runtime directories and SSH permissions
echo "[6/9] Checking permissions..."

# Borg cache dir for www-data
mkdir -p /var/bbs/cache/www-data
chown www-data:www-data /var/bbs/cache/www-data

# Fix per-user home and .ssh permissions (required for sshd StrictModes)
for user in $(getent passwd | grep '^bbs-' | cut -d: -f1); do
    home=$(getent passwd "$user" | cut -d: -f6)

    # Per-user borg cache dir
    borgdir="/var/bbs/cache/$user"
    mkdir -p "$borgdir"
    chown "$user":"$user" "$borgdir"

    # Ensure user is in www-data supplementary group (needed so chgrp in
    # bbs-ssh-gate's catalog-write works on FUSE/shfs where setgid is not
    # honored — without this, catalog files are unreadable by the web server)
    usermod -a -G www-data "$user" 2>/dev/null || true

    # Home dir: 750 for sshd compatibility, owned by user with www-data group
    if [ -d "$home" ]; then
        chown "$user":www-data "$home"
        chmod 750 "$home"

        # .ssh dir strict ownership. authorized_keys MUST be user-owned
        # (root-owned authorized_keys is rejected by sshd's StrictModes
        # on stock Ubuntu — sshd's privsep child can't read it as the
        # user, and authentication fails with "Permission denied
        # (publickey)"). The forced-command + 'restrict' directive in
        # the file is what enforces the security model — chmod 600
        # owned by the user is the standard, supported config.
        if [ -d "$home/.ssh" ]; then
            chown -R "$user":"$user" "$home/.ssh"
            chmod 700 "$home/.ssh"
            [ -f "$home/.ssh/authorized_keys" ] && chmod 600 "$home/.ssh/authorized_keys"
        fi
    fi
done

# 7. Verify sudoers
echo "[7/9] Verifying sudoers..."
SUDOERS_FILE="/etc/sudoers.d/bbs-ssh-helper"
EXPECTED="www-data ALL=(root) NOPASSWD: /usr/local/bin/bbs-ssh-helper, $BBS_DIR/bin/bbs-update"
if [ ! -f "$SUDOERS_FILE" ] || ! grep -q "bbs-update" "$SUDOERS_FILE"; then
    echo "$EXPECTED" > "$SUDOERS_FILE"
    chmod 440 "$SUDOERS_FILE"
    echo "  Updated"
else
    echo "  OK"
fi

# Remove the legacy bbs-borg sudoers file: nothing uses it since all borg/
# rclone commands moved into bbs-ssh-helper, and its "ALL=(bbs-*)" RunAs
# wildcard is invalid syntax on newer sudo — the parse error disables ALL
# sudo for www-data, breaking client provisioning entirely (#368).
if [ -f /etc/sudoers.d/bbs-borg ]; then
    rm -f /etc/sudoers.d/bbs-borg
    echo "  Removed legacy /etc/sudoers.d/bbs-borg"
fi

# 8. Run database migrations
echo "[8/9] Running database migrations..."
if ! sudo -u www-data php "$BBS_DIR/migrate.php" 2>&1; then
    # A failed migration leaves the schema behind what the code expects, which
    # shows up later as unrelated-looking errors. Say so plainly here rather
    # than letting it scroll past as a warning.
    echo ""
    echo "  ================================================================"
    echo "  DATABASE MIGRATION FAILED — see the errors above."
    echo "  The update is installed but the schema is not fully up to date."
    echo "  Migrations are retried on the next update, and until one succeeds"
    echo "  some features may not work correctly."
    echo "  ================================================================"
    echo ""
fi

# 9. Fix storage path permissions
echo "[9/9] Checking storage path permissions..."
ENV_FILE="$BBS_DIR/config/.env"
if [ -f "$ENV_FILE" ]; then
    DB_HOST=$(grep '^DB_HOST=' "$ENV_FILE" | cut -d= -f2-)
    DB_NAME=$(grep '^DB_NAME=' "$ENV_FILE" | cut -d= -f2-)
    DB_USER=$(grep '^DB_USER=' "$ENV_FILE" | cut -d= -f2-)
    DB_PASS=$(grep '^DB_PASS=' "$ENV_FILE" | cut -d= -f2-)

    if [ -n "$DB_NAME" ] && [ -n "$DB_USER" ]; then
        STORAGE_PATH=$(mysql -h "${DB_HOST:-localhost}" -u "$DB_USER" -p"$DB_PASS" "$DB_NAME" \
            -N -e "SELECT \`value\` FROM settings WHERE \`key\` = 'storage_path'" 2>/dev/null || true)

        if [ -n "$STORAGE_PATH" ]; then
            if [ ! -d "$STORAGE_PATH" ]; then
                mkdir -p "$STORAGE_PATH"
                echo "  Created $STORAGE_PATH"
            fi
            chown root:www-data "$STORAGE_PATH"
            chmod 775 "$STORAGE_PATH"
            echo "  OK $STORAGE_PATH"
        else
            echo "  No storage path configured"
        fi
    else
        echo "  Warning: could not read DB credentials from .env"
    fi
else
    echo "  Warning: .env not found, skipping"
fi

# Ensure the scheduler cron EXISTS and has the flock overlap guard. The old
# check only upgraded an existing www-data crontab line — an install whose
# scheduler cron lived elsewhere (or went missing) was left with no scheduler
# at all (#371). Docker is excluded: there entrypoint.sh owns the cron via
# /etc/cron.d with the container's php path.
if [ ! -f /.dockerenv ] && command -v crontab &>/dev/null && command -v flock &>/dev/null; then
    # Consolidate: bare-metal installs schedule via www-data's crontab. A
    # stray /etc/cron.d/bbs-scheduler (old restore, or the Docker block
    # copied by hand) double-schedules and often carries container-only
    # paths (/usr/local/bin/php, TMPDIR=/var/bbs/tmp) that break on bare
    # metal (#371).
    if [ -f /etc/cron.d/bbs-scheduler ]; then
        rm -f /etc/cron.d/bbs-scheduler
        echo "  Removed /etc/cron.d/bbs-scheduler (scheduler runs from www-data's crontab)"
    fi
    if ! crontab -u www-data -l 2>/dev/null | grep -q 'flock.*scheduler.php'; then
        GUARDED="* * * * * /usr/bin/flock -n /var/lock/bbs-scheduler.lock /usr/bin/php $BBS_DIR/scheduler.php >> /var/log/bbs-scheduler.log 2>&1"
        ( crontab -u www-data -l 2>/dev/null | grep -v 'scheduler.php' || true; echo "$GUARDED" ) | crontab -u www-data -
        echo "  Scheduler cron installed/updated (flock-guarded)"
    fi
    touch /var/log/bbs-scheduler.log
    chown www-data:www-data /var/log/bbs-scheduler.log 2>/dev/null || true
fi

# Scratch space matching the Docker layout — harmless if unused, and keeps
# any TMPDIR=/var/bbs/tmp configuration working on bare metal (#371)
mkdir -p /var/bbs/tmp
chmod 1777 /var/bbs/tmp 2>/dev/null || true

# Restore check staging (root-owned; the helper creates per-run directories).
if [ ! -L /var/bbs/restore-checks ]; then
    mkdir -p /var/bbs/restore-checks
    chown root:root /var/bbs/restore-checks
    chmod 755 /var/bbs/restore-checks
fi

# Apache systemd override for hardened units (Ubuntu 26.04+): the stock
# apache2.service hides /etc/sudoers and mounts /etc read-only, breaking the
# sudo -> bbs-ssh-helper provisioning flow (#368). Same drop-in bbs-install
# ships; installed here too so release-upgraded systems get it.
APACHE_DROPIN="/etc/systemd/system/apache2.service.d/bbs.conf"
if systemctl show apache2 -p InaccessiblePaths 2>/dev/null | grep -q sudoers || \
   systemctl show apache2 -p ProtectSystem 2>/dev/null | grep -qE '=(full|strict)$' || \
   systemctl show apache2 -p ProcSubset 2>/dev/null | grep -q '=pid$'; then
    mkdir -p /etc/systemd/system/apache2.service.d
    cat > "$APACHE_DROPIN.new" <<'APACHE_EOF'
[Service]
# BBS override for the hardened apache2 unit (Ubuntu 26.04+). The stock
# sandbox hides /etc/sudoers and mounts /etc read-only, which blocks the
# sudo -> bbs-ssh-helper provisioning flow (#368). This keeps ProtectSystem
# (/usr and /boot read-only) and every other hardening directive; it only
# restores sudoers visibility, /etc writes, and /usr/local/bin writes.
ProtectSystem=true
# The helper chmods setgid dirs (catalog logs); RestrictSUIDSGID=yes blocks
# creating sgid files entirely
RestrictSUIDSGID=no
# ProcSubset=pid mounts /proc with subset=pid for the service, hiding every
# file that is not a PID directory. ServerStats then cannot read
# /proc/meminfo (Server Health shows 0 B / 0 B) or /proc/net/dev (throughput
# stays null), while CPU keeps working through sys_getloadavg(), so the card
# looks like an idle machine rather than a broken read (#485).
# ProtectProc=invisible stays: it only hides other users' processes.
ProcSubset=all
InaccessiblePaths=
InaccessiblePaths=/boot
InaccessiblePaths=/root
InaccessiblePaths=-/etc/apt
InaccessiblePaths=-/etc/.git
InaccessiblePaths=-/etc/.svn
ReadWritePaths=-/usr/local/bin
APACHE_EOF
    if ! cmp -s "$APACHE_DROPIN.new" "$APACHE_DROPIN" 2>/dev/null; then
        mv "$APACHE_DROPIN.new" "$APACHE_DROPIN"
        systemctl daemon-reload
        if grep -q apache2.service /proc/self/cgroup 2>/dev/null; then
            # We're running inside Apache's cgroup (web-triggered update):
            # restarting Apache now would kill this update mid-run. Schedule
            # a detached restart from PID 1 instead.
            systemd-run --on-active=30 --unit=bbs-apache-override-restart \
                systemctl restart apache2 >/dev/null 2>&1 || \
                echo "  Apache override installed — restart apache2 to activate it"
            echo "  Apache override installed (restart scheduled)"
        else
            systemctl restart apache2
            echo "  Apache override installed and Apache restarted"
        fi
    else
        rm -f "$APACHE_DROPIN.new"
    fi
fi

# Restart PHP to clear OPcache (non-fatal — update is already complete at this point)
PHP_FPM=$(systemctl list-units --type=service --no-legend 2>/dev/null | grep -oP 'php[0-9.]+-fpm\.service' | head -1 || true)
if [ -n "$PHP_FPM" ]; then
    systemctl restart "$PHP_FPM" 2>/dev/null || echo "  Warning: could not restart $PHP_FPM (OPcache may serve stale code until next restart)"
else
    systemctl restart php-fpm 2>/dev/null || true
fi

echo ""
echo "=== Update complete ==="
