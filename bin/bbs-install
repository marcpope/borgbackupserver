#!/usr/bin/env bash
#
# BBS Install Script — takes a fresh Ubuntu 22.04+ server to "open the wizard."
#
# Usage:
#   sudo bash bbs-install [--hostname backups.example.com] [--no-ssl] [--email you@example.com]
#
set -euo pipefail

# ─── Colors & helpers ────────────────────────────────────────────────────────
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; CYAN='\033[0;36m'; BOLD='\033[1m'; NC='\033[0m'
ok()   { echo -e "  ${GREEN}✔${NC} $*"; }
info() { echo -e "  ${CYAN}⋯${NC} $*"; }
warn() { echo -e "  ${YELLOW}⚠${NC} $*"; }
fail() { echo -e "  ${RED}✘${NC} $*"; }
step() { echo -e "\n${CYAN}${BOLD}[$1] $2${NC}"; }
die()  { fail "$*"; exit 1; }

LOG_FILE="/var/log/bbs-install.log"
exec > >(stdbuf -oL tee -a "$LOG_FILE") 2>&1

# Ensure interactive prompts work even when piped (curl | sudo bash)
# Use /dev/tty for prompts when stdin is piped — but only if it's actually
# openable ([[ -e /dev/tty ]] is true even with no controlling terminal,
# e.g. ssh without -t, where opening it fails and killed the script)
if [[ ! -t 0 ]] && (exec 3</dev/tty) 2>/dev/null; then
    exec 3</dev/tty
else
    exec 3<&0
fi
ask() {
    # Extract prompt from -p arg and write it to stdout (same stream as all
    # our ok/info/echo output) so ordering stays correct through the
    # tee-to-logfile pipe. Previously writing to /dev/tty made prompts jump
    # ahead of buffered stdout and the user saw interleaved output (#155).
    local args=() prompt=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -p)  prompt="$2"; shift 2 ;;
            -rp) prompt="$2"; args+=(-r); shift 2 ;;
            *)   args+=("$1"); shift ;;
        esac
    done
    if [[ -n "$prompt" ]]; then
        printf "%s" "$prompt"
        # Force-flush the tee pipeline so the prompt actually reaches the
        # terminal before read() blocks for input.
        sleep 0.05
    fi
    read "${args[@]}" <&3
}

echo -e "${BOLD}═══════════════════════════════════════════════════${NC}"
echo -e "${BOLD}  BBS Installer${NC}"
echo -e "${BOLD}═══════════════════════════════════════════════════${NC}"

# ─── Parse arguments ─────────────────────────────────────────────────────────
HOSTNAME_ARG=""
NO_SSL=false
# Let's Encrypt account contact. The setup wizard collects the admin address
# after this script finishes, so there is nothing to read here — but expiry
# warnings go to this address, so take it when offered and push the admin's
# real one to the ACME account later (Settings -> SSL).
SSL_EMAIL=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        --hostname)  HOSTNAME_ARG="$2"; shift 2 ;;
        --no-ssl)    NO_SSL=true; shift ;;
        --email)     SSL_EMAIL="$2"; shift 2 ;;
        -h|--help)
            echo "Usage: sudo bash bbs-install [--hostname backups.example.com] [--no-ssl] [--email you@example.com]"
            exit 0 ;;
        *) die "Unknown argument: $1" ;;
    esac
done

# ─── Pre-flight ──────────────────────────────────────────────────────────────
step "0/10" "Pre-flight checks"

# Must be root
if [[ "$EUID" -ne 0 ]]; then
    die "Must run as root (use sudo)"
fi
ok "Running as root"

# Detect OS
if [[ ! -f /etc/os-release ]]; then
    die "Cannot detect OS — /etc/os-release not found"
fi
source /etc/os-release
if [[ "$ID" != "ubuntu" ]]; then
    die "Ubuntu required (detected: $ID)"
fi
MAJOR_VER="${VERSION_ID%%.*}"
if [[ "$MAJOR_VER" -lt 22 ]]; then
    die "Ubuntu 22.04+ required (detected: $VERSION_ID)"
fi
ok "Ubuntu $VERSION_ID detected"

# Existing install check
BBS_DIR="/var/www/bbs"
if [[ -f "$BBS_DIR/config/.env" ]]; then
    echo ""
    warn "BBS is already installed ($BBS_DIR/config/.env exists)."
    ask -rp "  Run the updater instead? [Y/n] " yn
    if [[ "${yn,,}" != "n" ]]; then
        exec "$BBS_DIR/bin/bbs-update"
    fi
    die "Aborted."
fi

if [[ -d "$BBS_DIR" ]]; then
    warn "Partial install detected ($BBS_DIR exists but no .env)."
    ask -rp "  Continue installation? [Y/n] " yn
    if [[ "${yn,,}" == "n" ]]; then
        die "Aborted."
    fi
fi

# ─── Step 1: Gather info ────────────────────────────────────────────────────
step "1/10" "Gather information"

# Hostname — auto-detect, then confirm with user
if [[ -z "$HOSTNAME_ARG" ]]; then
    # Try to detect a usable hostname
    DETECTED_HOST=""

    # 1) FQDN from hostname -f (most reliable if DNS is configured)
    if [[ -z "$DETECTED_HOST" ]]; then
        FQDN=$(hostname -f 2>/dev/null || true)
        if [[ -n "$FQDN" && "$FQDN" == *.* && "$FQDN" != "localhost"* ]]; then
            DETECTED_HOST="$FQDN"
        fi
    fi

    # 2) Reverse DNS of the primary public IP
    if [[ -z "$DETECTED_HOST" ]]; then
        PUB_IP=$(curl -s --max-time 5 ifconfig.me 2>/dev/null || true)
        if [[ -n "$PUB_IP" ]]; then
            RDNS=$(dig +short -x "$PUB_IP" 2>/dev/null | sed 's/\.$//' || true)
            if [[ -n "$RDNS" && "$RDNS" == *.* && "$RDNS" != "localhost"* ]]; then
                DETECTED_HOST="$RDNS"
            fi
        fi
    fi

    # 3) First non-localhost hostname from /etc/hosts
    if [[ -z "$DETECTED_HOST" ]]; then
        ETC_HOST=$(grep -v '^\s*#' /etc/hosts 2>/dev/null | grep -v 'localhost' | awk '{for(i=2;i<=NF;i++) if($i ~ /\./) {print $i; exit}}' || true)
        if [[ -n "$ETC_HOST" ]]; then
            DETECTED_HOST="$ETC_HOST"
        fi
    fi

    if [[ -n "$DETECTED_HOST" ]]; then
        ask -rp "  Server hostname [$DETECTED_HOST]: " HOSTNAME_ARG
        HOSTNAME_ARG="${HOSTNAME_ARG:-$DETECTED_HOST}"
    else
        ask -rp "  Server hostname (e.g. backups.example.com): " HOSTNAME_ARG
    fi
fi
if [[ -z "$HOSTNAME_ARG" ]]; then
    die "Hostname is required"
fi

# Validate hostname: must be a valid FQDN or IPv4/IPv6 address
validate_hostname() {
    local h="$1"
    # IPv4: digits and dots, 4 octets 0-255
    if [[ "$h" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
        IFS='.' read -r a b c d <<< "$h"
        if (( a <= 255 && b <= 255 && c <= 255 && d <= 255 )); then
            return 0
        fi
        return 1
    fi
    # IPv6: hex digits and colons (simplified check)
    if [[ "$h" =~ ^[0-9a-fA-F:]+$ && "$h" == *:* ]]; then
        return 0
    fi
    # FQDN: RFC 1123 — alphanumeric labels separated by dots, hyphens allowed (not leading/trailing)
    if [[ "$h" =~ ^([a-zA-Z0-9]([a-zA-Z0-9-]*[a-zA-Z0-9])?\.)+[a-zA-Z]{2,}$ ]]; then
        return 0
    fi
    return 1
}

if ! validate_hostname "$HOSTNAME_ARG"; then
    die "Invalid hostname '$HOSTNAME_ARG' — must be a valid domain name (e.g. backups.example.com) or IP address"
fi

BBS_HOSTNAME="$HOSTNAME_ARG"
ok "Hostname: $BBS_HOSTNAME"

# Port 80 has to be free, or already Apache's, for the rest of this to work.
# Apache cannot bind it while another server holds it, and a certificate cannot
# be issued without it — but the symptom surfaces much later as a failed reload
# or a confusing certbot error, so say it here instead (#431).
PORT80_PROC=""
# `|| true`: under set -o pipefail an empty grep result fails the pipeline,
# and under set -e that killed the whole installer — on every machine where
# port 80 was free, which is every fresh install.
if command -v ss &>/dev/null; then
    PORT80_PROC=$(ss -lntpH 2>/dev/null | awk '$4 ~ /:80$/' | grep -oE '\(\("[^"]+' | sed 's/(("//' | sort -u | paste -sd, - || true)
elif command -v lsof &>/dev/null; then
    PORT80_PROC=$(lsof -nP -iTCP:80 -sTCP:LISTEN -Fc 2>/dev/null | sed -n 's/^c//p' | sort -u | paste -sd, - || true)
fi

if [[ -n "$PORT80_PROC" && "$PORT80_PROC" != *apache2* ]]; then
    warn "Port 80 is already in use by: $PORT80_PROC"
    warn "Apache will not start while another server holds port 80, and no certificate can be issued."
    warn "Stop it or move it to another port, then re-run this installer."
elif [[ -n "$PORT80_PROC" ]]; then
    ok "Port 80 is served by Apache"
fi

# DNS check (only with SSL)
#
# Resolution only, and never fatal. Comparing the A record against this
# server's public IPv4 looked like a check on "can Let's Encrypt reach us" and
# was not: it fails on IPv6-only hosts, behind NAT gateways, on round-robin
# records and anything fronted by a CDN, and it aborted installs that would
# have succeeded (#431). The certificate request itself is the real check, and
# it runs as a dry run once Apache is up.
if [[ "$NO_SSL" == false ]]; then
    RESOLVED=""
    if command -v getent &>/dev/null; then
        # getent covers A and AAAA, and honours the resolver the machine
        # actually uses rather than querying DNS directly.
        RESOLVED=$(getent ahosts "$BBS_HOSTNAME" 2>/dev/null | awk '{print $1}' | sort -u | paste -sd' ' -)
    elif command -v dig &>/dev/null; then
        RESOLVED=$(dig +short "$BBS_HOSTNAME" | paste -sd' ' -)
    fi

    if [[ -n "$RESOLVED" ]]; then
        ok "$BBS_HOSTNAME resolves to $RESOLVED"
    else
        warn "$BBS_HOSTNAME does not resolve yet — the certificate request will fail unless DNS is in place"
    fi
else
    ok "SSL disabled — skipping DNS check"
fi

# MySQL credentials
echo ""
echo "  MySQL setup: BBS needs a database."
ask -rp "  Auto-generate a 'bbs' database user with random password? [Y/n] " auto_db
if [[ "${auto_db,,}" != "n" ]]; then
    DB_USER="bbs"
    DB_PASS=$(openssl rand -base64 24 | tr -dc 'A-Za-z0-9' | head -c 24)
    DB_NAME="bbs"
    DB_AUTO=true
    ok "Will create database 'bbs' with user 'bbs'"
else
    ask -rp "  MySQL root password (or press Enter for none): " -s DB_ROOT_PASS
    echo ""
    DB_USER="bbs"
    DB_PASS=$(openssl rand -base64 24 | tr -dc 'A-Za-z0-9' | head -c 24)
    DB_NAME="bbs"
    DB_AUTO=false
    ok "Will use provided root credentials to create database"
fi

# ─── Step 2: Install system packages ────────────────────────────────────────
step "2/10" "Install system packages"

export DEBIAN_FRONTEND=noninteractive
info "Updating apt package index..."
apt-get update -qq

PACKAGES=(
    apache2 libapache2-mod-php
    php php-mysql php-mbstring php-xml php-curl php-memcached
    mysql-server borgbackup composer git openssh-server
    memcached certbot python3-certbot-apache
    dnsutils  # for dig
    python3-pip  # for apprise
    cron  # not installed on ubuntu-minimal by default (#155)
)

info "Installing ${#PACKAGES[@]} packages (this can take a few minutes, please be patient)..."
INSTALLED=0
for pkg in "${PACKAGES[@]}"; do
    INSTALLED=$((INSTALLED + 1))
    printf "  ${CYAN}⋯${NC} [%d/%d] %s...\\r" "$INSTALLED" "${#PACKAGES[@]}" "$pkg"
    if ! apt-get install -y -qq "$pkg" > /dev/null 2>&1; then
        echo ""
        warn "Failed to install $pkg (continuing)"
    fi
done
echo ""
ok "System packages installed (${#PACKAGES[@]} packages)"

info "Installing Apprise notification tool..."
pip3 install --break-system-packages --no-cache-dir apprise > /dev/null 2>&1 \
    || pip3 install --no-cache-dir apprise > /dev/null 2>&1
ok "Apprise installed"

# Install rclone from official binary (apt package ships outdated Go runtime with CVEs)
info "Installing rclone..."
ARCH=$(dpkg --print-architecture)
curl -fsSL "https://downloads.rclone.org/rclone-current-linux-${ARCH}.zip" -o /tmp/rclone.zip \
    && unzip -qo /tmp/rclone.zip -d /tmp \
    && cp /tmp/rclone-*/rclone /usr/bin/rclone \
    && chmod 755 /usr/bin/rclone \
    && rm -rf /tmp/rclone*
ok "rclone installed ($(rclone --version 2>/dev/null | head -1))"

# Enable Apache modules
a2enmod rewrite ssl headers > /dev/null 2>&1
ok "Apache modules enabled (rewrite, ssl, headers)"

# ─── Step 3: Install ClickHouse ──────────────────────────────────────────────
step "3/11" "Install ClickHouse"

if command -v clickhouse-server &>/dev/null; then
    ok "ClickHouse already installed ($(clickhouse-client --version 2>/dev/null | head -1 || echo 'unknown'))"
else
    info "Adding ClickHouse repository..."
    curl -fsSL -A 'Mozilla/5.0' 'https://packages.clickhouse.com/rpm/lts/repodata/repomd.xml.key' | \
        gpg --dearmor -o /usr/share/keyrings/clickhouse-keyring.gpg 2>/dev/null
    ARCH=$(dpkg --print-architecture)
    echo "deb [signed-by=/usr/share/keyrings/clickhouse-keyring.gpg arch=${ARCH}] https://packages.clickhouse.com/deb stable main" \
        > /etc/apt/sources.list.d/clickhouse.list
    apt-get update -qq 2>/dev/null

    info "Installing ClickHouse server and client..."
    # Pinned to the same version as the Docker image (see Dockerfile
    # CLICKHOUSE_VERSION). Unpinned "stable" drifts to builds that raise the
    # CPU-instruction baseline and crash with "Illegal instruction" on older
    # CPUs (#327) — and a failed install here silently aborts the installer.
    CLICKHOUSE_VERSION="26.5.2.39"
    if ! DEBIAN_FRONTEND=noninteractive apt-get install -y \
        clickhouse-common-static="$CLICKHOUSE_VERSION" \
        clickhouse-server="$CLICKHOUSE_VERSION" \
        clickhouse-client="$CLICKHOUSE_VERSION" > /dev/null 2>&1; then
        die "ClickHouse ${CLICKHOUSE_VERSION} install failed — run 'apt-get install clickhouse-server=${CLICKHOUSE_VERSION}' manually to see why"
    fi
    apt-mark hold clickhouse-common-static clickhouse-server clickhouse-client >/dev/null 2>&1 || true

    # Config override will be installed by bbs-update after BBS code is downloaded
    mkdir -p /etc/clickhouse-server/config.d

    systemctl enable --now clickhouse-server > /dev/null 2>&1

    # Wait for startup
    for i in {1..10}; do
        curl -sf http://localhost:8123/ping >/dev/null 2>&1 && break
        sleep 1
    done

    ok "ClickHouse installed and started"
fi

# ClickHouse catalog tables are created after BBS code is downloaded (needs schema-clickhouse.sql)

# ─── Step 4: Create database ────────────────────────────────────────────────
step "4/11" "Create database"

# Check if database already exists
if mysql -e "USE $DB_NAME" 2>/dev/null; then
    warn "Database '$DB_NAME' already exists — skipping creation"
else
    mysql -e "CREATE DATABASE \`$DB_NAME\` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;"
    ok "Database '$DB_NAME' created"
fi

# Check if user already exists
if mysql -e "SELECT User FROM mysql.user WHERE User='$DB_USER' AND Host='localhost'" 2>/dev/null | grep -q "$DB_USER"; then
    warn "User '$DB_USER' already exists — updating password"
    mysql -e "ALTER USER '$DB_USER'@'localhost' IDENTIFIED BY '$DB_PASS';"
else
    mysql -e "CREATE USER '$DB_USER'@'localhost' IDENTIFIED BY '$DB_PASS';"
    ok "User '$DB_USER' created"
fi

mysql -e "GRANT ALL PRIVILEGES ON \`$DB_NAME\`.* TO '$DB_USER'@'localhost'; FLUSH PRIVILEGES;"
ok "Privileges granted"

# ─── Step 4: Download BBS ───────────────────────────────────────────────────
step "5/11" "Download BBS"

if [[ -d "$BBS_DIR/.git" ]]; then
    warn "Repository already cloned — fetching latest"
    git config --global --add safe.directory "$BBS_DIR" 2>/dev/null || true
    git -C "$BBS_DIR" fetch --tags --force --quiet
else
    if [[ -d "$BBS_DIR" ]]; then
        # Directory exists but not a git repo — remove and clone fresh
        rm -rf "$BBS_DIR"
    fi
    git clone --quiet https://github.com/marcpope/borgbackupserver.git "$BBS_DIR"
    ok "Cloned to $BBS_DIR"
fi

# Check out the latest release tag instead of staying on main
LATEST_TAG=$(git -C "$BBS_DIR" tag --sort=-v:refname | grep -E '^v[0-9]' | head -1)
if [[ -n "$LATEST_TAG" ]]; then
    git -C "$BBS_DIR" checkout "$LATEST_TAG" --quiet
    ok "Checked out release $LATEST_TAG"
else
    warn "No release tags found — using main branch"
fi

cd "$BBS_DIR"
info "Installing Composer dependencies..."
# --no-interaction is critical: without it Composer prompts on stdin (e.g.
# "enter a GitHub token" when GitHub API rate-limits a dist download on a
# shared cloud IP) and, because the old command hid output with 2>/dev/null,
# the installer just hung silently at this step (#351). Run it visibly, log
# to a file, and fail loudly with the log on any error instead of hanging.
export COMPOSER_ALLOW_SUPERUSER=1 COMPOSER_NO_INTERACTION=1
COMPOSER_LOG="/tmp/bbs-composer-install.log"
if ! composer install --no-dev --optimize-autoloader --no-interaction --no-progress 2>&1 | tee "$COMPOSER_LOG"; then
    fail "Composer failed to install PHP dependencies. Full output above and in $COMPOSER_LOG"
    echo "  Common causes: no outbound HTTPS to packagist.org/GitHub, or GitHub API rate-limiting."
    echo "  If rate-limited, create a token at https://github.com/settings/tokens and run:"
    echo "    composer config --global github-oauth.github.com <TOKEN>"
    echo "  then re-run this installer."
    exit 1
fi
ok "Composer dependencies installed"

chown -R www-data:www-data "$BBS_DIR"
ok "Ownership set to www-data"

# Create ClickHouse catalog tables (deferred from step 3 — needs BBS code for schema file)
if command -v clickhouse-client &>/dev/null; then
    if [ -f "$BBS_DIR/config/clickhouse-server-override.xml" ]; then
        cp "$BBS_DIR/config/clickhouse-server-override.xml" /etc/clickhouse-server/config.d/bbs-override.xml
        systemctl restart clickhouse-server 2>/dev/null || true
        sleep 2
    fi
    info "Creating ClickHouse catalog tables..."
    clickhouse-client --query "CREATE DATABASE IF NOT EXISTS bbs" 2>/dev/null
    clickhouse-client -d bbs --multiquery < "$BBS_DIR/schema-clickhouse.sql" 2>/dev/null
    ok "ClickHouse catalog tables ready"
fi

# ─── Step 5: Create system directories ───────────────────────────────────────
step "6/11" "Create system directories"

mkdir -p /var/bbs/cache /var/bbs/home
chown www-data:www-data /var/bbs /var/bbs/cache /var/bbs/home
chmod 755 /var/bbs /var/bbs/cache /var/bbs/home
ok "Created /var/bbs/cache"
ok "Created /var/bbs/home (default storage path)"

# ─── Step 6: SSH helper & sudoers ───────────────────────────────────────────
step "7/11" "Install SSH helper & sudoers"

cp "$BBS_DIR/bin/bbs-ssh-helper" /usr/local/bin/bbs-ssh-helper
chmod 755 /usr/local/bin/bbs-ssh-helper
ok "SSH helper installed"

sudo /usr/local/bin/bbs-ssh-helper install-gate
ok "SSH gate installed"

echo "www-data ALL=(root) NOPASSWD: /usr/local/bin/bbs-ssh-helper, $BBS_DIR/bin/bbs-update" \
    > /etc/sudoers.d/bbs-ssh-helper
chmod 440 /etc/sudoers.d/bbs-ssh-helper
ok "SSH helper sudoers configured"

# Note: no /etc/sudoers.d/bbs-borg — all borg/rclone commands run through
# bbs-ssh-helper. The old "www-data ALL=(bbs-*)" rule is invalid syntax on
# newer sudo (breaks every www-data sudo call, #368) and unnecessary.

# Ubuntu 26.04+ ships a hardened apache2.service that hides /etc/sudoers
# from the service (InaccessiblePaths) and mounts /etc read-only
# (ProtectSystem=full). Both break the sudo → bbs-ssh-helper provisioning
# flow (#368). Install a drop-in that keeps the hardening but restores the
# minimum BBS needs: sudoers visibility, writable /etc (useradd), writable
# /usr/local/bin (borg updates). /usr and /boot stay read-only.
if systemctl show apache2 -p InaccessiblePaths 2>/dev/null | grep -q sudoers || \
   systemctl show apache2 -p ProtectSystem 2>/dev/null | grep -qE '=(full|strict)$'; then
    mkdir -p /etc/systemd/system/apache2.service.d
    cat > /etc/systemd/system/apache2.service.d/bbs.conf <<'APACHE_EOF'
[Service]
# BBS override for the hardened apache2 unit (Ubuntu 26.04+). The stock
# sandbox hides /etc/sudoers and mounts /etc read-only, which blocks the
# sudo -> bbs-ssh-helper provisioning flow (#368). This keeps ProtectSystem
# (/usr and /boot read-only) and every other hardening directive; it only
# restores sudoers visibility, /etc writes, and /usr/local/bin writes.
ProtectSystem=true
# The helper chmods setgid dirs (catalog logs); RestrictSUIDSGID=yes blocks
# creating sgid files entirely
RestrictSUIDSGID=no
InaccessiblePaths=
InaccessiblePaths=/boot
InaccessiblePaths=/root
InaccessiblePaths=-/etc/apt
InaccessiblePaths=-/etc/.git
InaccessiblePaths=-/etc/.svn
ReadWritePaths=-/usr/local/bin
APACHE_EOF
    systemctl daemon-reload
    systemctl restart apache2
    ok "Apache systemd override installed (hardened unit detected)"
fi

# Install the latest server-hosted borg binary (if available) to replace the apt version
BORG_PUBLIC="$BBS_DIR/public/borg"
if [ -d "$BORG_PUBLIC" ]; then
    # Find the highest version directory
    LATEST_VER=$(ls -1 "$BORG_PUBLIC" 2>/dev/null | sort -V | tail -1)
    if [ -n "$LATEST_VER" ]; then
        # Find a linux x86_64 binary
        BORG_BIN=$(ls "$BORG_PUBLIC/$LATEST_VER"/borg-linux-glibc*-x86_64 2>/dev/null | head -1)
        if [ -n "$BORG_BIN" ]; then
            cp "$BORG_BIN" /usr/local/bin/borg
            chmod 755 /usr/local/bin/borg
            INSTALLED_VER=$(/usr/local/bin/borg --version 2>/dev/null | grep -oP '[\d.]+' || echo "$LATEST_VER")
            ok "Borg $INSTALLED_VER installed from server-hosted binary"
        fi
    fi
fi

# ─── Step 7: Configure Apache ───────────────────────────────────────────────
step "8/11" "Configure Apache"

a2dissite 000-default > /dev/null 2>&1 || true

if [[ "$NO_SSL" == true ]]; then
    # HTTP-only vhost
    cat > /etc/apache2/sites-available/bbs.conf <<VHOST
<VirtualHost *:80>
    ServerName $BBS_HOSTNAME
    DocumentRoot $BBS_DIR/public

    <Directory $BBS_DIR/public>
        AllowOverride All
        Require all granted
    </Directory>

    ErrorLog \${APACHE_LOG_DIR}/bbs-error.log
    CustomLog \${APACHE_LOG_DIR}/bbs-access.log combined
</VirtualHost>
VHOST
    ok "HTTP-only vhost created"
else
    # HTTP → HTTPS redirect + HTTPS vhost (certbot will fill in the cert paths)
    cat > /etc/apache2/sites-available/bbs.conf <<VHOST
<VirtualHost *:80>
    ServerName $BBS_HOSTNAME
    DocumentRoot $BBS_DIR/public

    <Directory $BBS_DIR/public>
        AllowOverride All
        Require all granted
    </Directory>

    ErrorLog \${APACHE_LOG_DIR}/bbs-error.log
    CustomLog \${APACHE_LOG_DIR}/bbs-access.log combined
</VirtualHost>
VHOST
    ok "HTTP vhost created (certbot will add HTTPS)"
fi

a2ensite bbs > /dev/null 2>&1
systemctl reload apache2
ok "Apache reloaded"

# ─── Step 8: SSL certificate ────────────────────────────────────────────────
step "9/11" "SSL certificate"

if [[ "$NO_SSL" == true ]]; then
    ok "Skipped (--no-ssl)"
    PROTO="http"
else
    PROTO="https"
    # Register with a real address when one was given. The setup wizard has
    # not run yet, so there is no admin account to read one from; whatever is
    # entered there is pushed to the ACME account afterwards from
    # Settings -> SSL. Guessing admin@$BBS_HOSTNAME only sent expiry warnings
    # to a mailbox that usually does not exist.
    if [[ -n "$SSL_EMAIL" ]]; then
        CERTBOT_ACCOUNT=(--email "$SSL_EMAIL")
        ok "Let's Encrypt contact: $SSL_EMAIL"
    else
        CERTBOT_ACCOUNT=(--register-unsafely-without-email)
        info "No --email given; registering without a contact address. Set one later in Settings -> SSL so expiry warnings reach you."
    fi

    # Dry run first, against the same plugin the real request uses. Apache is
    # already serving port 80 here, so this needs no temporary install and
    # cannot collide with a running web server the way --standalone does.
    info "Testing whether a certificate can be issued for $BBS_HOSTNAME..."
    if certbot --apache -d "$BBS_HOSTNAME" --non-interactive --agree-tos "${CERTBOT_ACCOUNT[@]}" --dry-run >> "$LOG_FILE" 2>&1; then
        ok "Certificate request test passed"
    else
        fail "A certificate cannot be issued for $BBS_HOSTNAME yet. Common causes:"
        fail "  - Port 80 not reachable from the internet (firewall, NAT, security group)"
        fail "  - $BBS_HOSTNAME does not point at this server"
        fail "  - An AAAA record exists but port 80 is not served over IPv6"
        fail "  - Another site on this server already answers for $BBS_HOSTNAME"
        warn "Install continues over HTTP. Fix the above, then run: certbot --apache -d $BBS_HOSTNAME"
        warn "Certbot's own output is in $LOG_FILE"
        PROTO="http"
    fi
fi

if [[ "$PROTO" == "https" ]]; then
    if certbot --apache -d "$BBS_HOSTNAME" --non-interactive --agree-tos "${CERTBOT_ACCOUNT[@]}" 2>&1; then
        ok "SSL certificate obtained"
    else
        fail "Certbot failed — ensure DNS for $BBS_HOSTNAME points to this server"
        fail "You can re-run: certbot --apache -d $BBS_HOSTNAME"
        warn "Continuing without SSL — the wizard will still be accessible via HTTP"
        PROTO="http"
    fi
fi

# ─── Step 9: Setup cron ─────────────────────────────────────────────────────
step "10/11" "Setup cron"

touch /var/log/bbs-scheduler.log
chown www-data:www-data /var/log/bbs-scheduler.log
# flock -n: only one scheduler runs at a time. Without it, a run that hangs
# (e.g. blocked on an unresponsive NFS storage mount) doesn't stop cron from
# launching another every minute — they pile up, each holding a MySQL
# connection, until the connection pool is exhausted and the whole web UI
# 500s (falcon outage, 2026-07-21). If a run is still going, the next tick
# skips instead of stacking.
CRON_LINE="* * * * * /usr/bin/flock -n /var/lock/bbs-scheduler.lock /usr/bin/php $BBS_DIR/scheduler.php >> /var/log/bbs-scheduler.log 2>&1"
# Drop any previous unguarded scheduler line so we don't end up with both.
( crontab -u www-data -l 2>/dev/null | grep -v 'scheduler.php' || true; echo "$CRON_LINE" ) | sort -u | crontab -u www-data -
ok "Scheduler cron installed"

# ─── Step 10: Set timezone ──────────────────────────────────────────────────
step "11/11" "Set server timezone to UTC"

ln -sf /usr/share/zoneinfo/UTC /etc/localtime
echo "UTC" > /etc/timezone
ok "Timezone set to UTC"

# ─── Summary ─────────────────────────────────────────────────────────────────
echo ""
echo -e "${BOLD}═══════════════════════════════════════════════════${NC}"
echo -e "${BOLD}  BBS Installation Complete!${NC}"
echo -e "${BOLD}═══════════════════════════════════════════════════${NC}"
echo ""
echo -e "  Open the setup wizard to finish configuration:"
echo -e "  ${CYAN}${BOLD}${PROTO}://${BBS_HOSTNAME}${NC}"
echo ""
echo -e "  The wizard will guide you through:"
echo -e "  ${GREEN}•${NC} Database connection (credentials below)"
echo -e "  ${GREEN}•${NC} Admin account creation"
echo -e "  ${GREEN}•${NC} Storage configuration"
echo ""
echo -e "  ${BOLD}Database Credentials (save these):${NC}"
echo -e "  ─────────────────────────────────"
echo -e "  Host:     localhost"
echo -e "  Database: $DB_NAME"
echo -e "  User:     $DB_USER"
echo -e "  Password: $DB_PASS"
echo ""
echo -e "  ${BOLD}Useful commands:${NC}"
echo -e "  ${GREEN}•${NC} Update:    sudo $BBS_DIR/bin/bbs-update"
echo -e "  ${GREEN}•${NC} Logs:      tail -f /var/log/bbs-scheduler.log"
if [[ "$NO_SSL" == false ]]; then
echo -e "  ${GREEN}•${NC} SSL renew: certbot renew"
fi
echo ""
echo -e "${BOLD}═══════════════════════════════════════════════════${NC}"
